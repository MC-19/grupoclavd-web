---
import Analytics from "@vercel/analytics/astro";
import AnalyticsConsent from "../components/analytics/AnalyticsConsent.astro";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import { company } from "../data/company";
import { paths } from "../data/navigation";
import { serviceAdvice } from "../data/serviceAdvice";
import { canonicalPath, breadcrumbSchema } from "../lib/seo";
import Container from "../components/ui/Container.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/og-image.png",
  type = "website",
  schemas = [],
} = Astro.props;

const canonicalURL = new URL(canonicalPath(Astro.url.pathname), Astro.site);
const advice = serviceAdvice[canonicalURL.pathname];
const serviceBreadcrumbs = advice ? [
  { name: "Inicio", href: paths.home },
  { name: "Servicios", href: paths.services },
  advice.parent,
  { name: advice.name, href: canonicalURL.pathname },
] : [];
const serviceSchemas = advice ? [
  {
    "@context": "https://schema.org", "@type": "Service",
    "@id": `${canonicalURL}#servicio`, url: canonicalURL.toString(),
    name: advice.name, description,
    provider: { "@type": "Organization", name: "GrupoClavD", url: company.domain },
  },
  breadcrumbSchema(serviceBreadcrumbs, Astro.site!),
] : [];
const socialImageURL = new URL(image, Astro.site);
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "GrupoClavD",
  legalName: company.legalName,
  foundingDate: "2019",
  founder: { "@type": "Person", name: "Valentín Vasile Dascalu" },
  areaServed: [
    { "@type": "City", name: "Elche" },
    { "@type": "AdministrativeArea", name: "Alicante" },
    { "@type": "Country", name: "España" },
  ],
  url: company.domain,
  email: company.email,
  telephone: company.phoneHref,
  address: {
    "@type": "PostalAddress",
    streetAddress: "C/ Capitán Gaspar Ortiz 88",
    postalCode: "03201",
    addressLocality: "Elche",
    addressRegion: "Alicante",
    addressCountry: "ES",
  },
};
---

<!doctype html>
<html lang="es" class="h-full scroll-smooth">
  <head>
    <meta charset="utf-8" />


    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL.toString()} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="GrupoClavD" />
    <meta property="og:locale" content="es_ES" />

    <meta property="og:title" content={title} />

    <meta property="og:description" content={description} />

    <meta property="og:url" content={canonicalURL.toString()} />

    <meta property="og:image" content={socialImageURL.toString()} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="twitter:title" content={title} />

    <meta name="twitter:description" content={description} />

    <meta name="twitter:image" content={socialImageURL.toString()} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    {[...serviceSchemas, ...schemas].map((schema) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      />
    ))}
    <Analytics />
  </head>

  <body>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido</a>

    <Header />

    <main id="contenido-principal" tabindex="-1">
      {advice && <Container><nav aria-label="Ruta de navegación" class="pt-6 text-sm text-(--color-foreground-muted)"><ol class="flex flex-wrap gap-2">{serviceBreadcrumbs.map((item, index) => <li>{index > 0 && <span aria-hidden="true" class="mr-2">/</span>}{index === serviceBreadcrumbs.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.href} class="underline underline-offset-4">{item.name}</a>}</li>)}</ol></nav></Container>}
      <slot />
    </main>

    <Footer />
    <AnalyticsConsent />
  </body>
</html>
