---
const measurementId = "G-9JF2L5RGN9";
---

<div
  id="analytics-consent-banner"
  class="fixed inset-x-4 bottom-4 z-[100] mx-auto hidden max-w-3xl rounded-2xl border border-(--color-border-strong) bg-white p-5 shadow-2xl sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="analytics-consent-title"
>
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-2xl">
      <h2 id="analytics-consent-title" class="text-lg font-black text-(--color-foreground)">
        Cookies analíticas
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-(--color-foreground-muted)">
        Usamos Google Analytics para entender cómo se utiliza la web y mejorarla. Solo lo activaremos si lo aceptas.
        Puedes cambiar tu decisión en cualquier momento desde el pie de página.
        <a href="/cookies/" class="font-semibold text-(--color-accent-500) underline underline-offset-4">
          Más información
        </a>.
      </p>
    </div>

    <div class="flex shrink-0 flex-col gap-2 sm:flex-row">
      <button
        id="analytics-reject"
        type="button"
        class="inline-flex min-h-11 items-center justify-center rounded-xl border border-(--color-border-strong) px-5 py-2.5 font-semibold text-(--color-foreground) transition hover:bg-(--color-surface-muted) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent-500)"
      >
        Solo necesarias
      </button>
      <button
        id="analytics-accept"
        type="button"
        class="inline-flex min-h-11 items-center justify-center rounded-xl bg-(--color-foreground) px-5 py-2.5 font-semibold text-white transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent-500)"
      >
        Aceptar analíticas
      </button>
    </div>
  </div>
</div>

<script define:vars={{ measurementId }} is:inline>
  (() => {
    // Evita registrar de nuevo los listeners si se evalúa el componente dos veces.
    if (window.__gcAnalyticsInitialized) return;
    window.__gcAnalyticsInitialized = true;
    const consentKey = "grupoclavd-analytics-consent";
    const disableKey = `ga-disable-${measurementId}`;
    const banner = document.getElementById("analytics-consent-banner");
    const acceptButton = document.getElementById("analytics-accept");
    const rejectButton = document.getElementById("analytics-reject");
    const allowedEvents = new Set(["generate_lead", "begin_quote", "click_whatsapp", "click_phone", "click_email"]);
    const trackedLeads = new Set();
    let analyticsLoaded = false;
    let beginQuoteTracked = false;
    let consent = null;
    try {
      consent = localStorage.getItem(consentKey);
    } catch {
      // Si el almacenamiento está bloqueado, la decisión dura solo esta página.
    }

    window[disableKey] = consent !== "granted";
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () {
      window.dataLayer.push(arguments);
    };
    window.gtag("consent", "default", {
      analytics_storage: "denied",
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
    });

    function safePageURL(value) {
      const url = new URL(value, window.location.origin);
      url.searchParams.delete("asunto");
      url.searchParams.delete("mensaje");
      url.hash = "";
      return url.toString();
    }

    function track(eventName, params = {}) {
      if (consent !== "granted" || !analyticsLoaded || !allowedEvents.has(eventName)) return;
      if (eventName === "generate_lead") {
        // Una respuesta satisfactoria tiene un ID propio; repetirla no suma otro lead.
        if (typeof params.event_id !== "string" || !params.event_id || trackedLeads.has(params.event_id)) return;
        trackedLeads.add(params.event_id);
        params = {
          event_id: params.event_id,
          lead_source: params.lead_source === "quote" ? "quote" : "contact",
        };
      } else {
        params = {};
      }
      try {
        window.gtag("event", eventName, {
          ...params,
          send_to: measurementId,
          page_location: safePageURL(window.location.href),
        });
      } catch {
        // Los bloqueadores o fallos de medición no afectan al contacto.
      }
    }

    function trackBeginQuoteIfNeeded() {
      if (beginQuoteTracked || consent !== "granted") return;
      const normalizedPath = `${window.location.pathname.replace(/\/$/, "")}/`;
      if (normalizedPath !== "/presupuesto/") return;
      beginQuoteTracked = true;
      track("begin_quote");
    }

    function loadAnalytics() {
      window[disableKey] = false;
      window.gtag("consent", "update", {
        analytics_storage: "granted",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
      });
      if (!analyticsLoaded) {
        analyticsLoaded = true;
        const script = document.createElement("script");
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
        document.head.appendChild(script);
        window.gtag("js", new Date());
        window.gtag("config", measurementId, {
          send_page_view: true,
          page_location: safePageURL(window.location.href),
          page_referrer: document.referrer ? safePageURL(document.referrer) : "",
          allow_google_signals: false,
          allow_ad_personalization_signals: false,
        });
      }
      trackBeginQuoteIfNeeded();
    }

    function saveConsent(value) {
      consent = value;
      try {
        localStorage.setItem(consentKey, value);
      } catch {
        // No impedir el uso del formulario ni de las preferencias.
      }
    }

    function clearAnalyticsCookies() {
      const hostParts = window.location.hostname.split(".");
      const domains = ["", ...hostParts.map((_, index) => `.${hostParts.slice(index).join(".")}`)];
      for (const cookie of document.cookie.split(";")) {
        const name = cookie.split("=")[0].trim();
        if (name !== "_ga" && !name.startsWith("_ga_")) continue;
        for (const domain of domains) {
          document.cookie = `${name}=; Max-Age=0; path=/${domain ? `; domain=${domain}` : ""}`;
        }
      }
    }

    function stopAnalytics() {
      // Consent mode por sí solo puede permitir pings sin cookies tras una retirada.
      window[disableKey] = true;
      window.gtag("consent", "update", {
        analytics_storage: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
      });
      clearAnalyticsCookies();
    }

    acceptButton?.addEventListener("click", () => {
      saveConsent("granted");
      banner?.classList.add("hidden");
      loadAnalytics();
    });
    rejectButton?.addEventListener("click", () => {
      saveConsent("denied");
      stopAnalytics();
      banner?.classList.add("hidden");
    });

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target.closest("a") : null;
      if (!(target instanceof HTMLAnchorElement)) return;
      const href = target.getAttribute("href") || "";
      if (href.startsWith("https://wa.me/")) track("click_whatsapp");
      else if (href.startsWith("tel:")) track("click_phone");
      else if (href.startsWith("mailto:")) track("click_email");
    });
    document.addEventListener("gc:track", (event) => {
      if (!(event instanceof CustomEvent)) return;
      track(event.detail?.event, event.detail?.params || {});
    });
    document.addEventListener("gc:manage-consent", () => banner?.classList.remove("hidden"));
    window.addEventListener("storage", (event) => {
      if (event.key !== consentKey && event.key !== null) return;
      consent = event.newValue;
      if (consent === "granted") loadAnalytics();
      else {
        stopAnalytics();
        if (consent !== "denied") banner?.classList.remove("hidden");
      }
    });

    if (consent === "granted") loadAnalytics();
    else {
      clearAnalyticsCookies();
      if (consent !== "denied") banner?.classList.remove("hidden");
    }
  })();
</script>
