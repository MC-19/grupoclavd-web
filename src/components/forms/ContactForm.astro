---
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY?.trim() ?? "";
const ready = Boolean(accessKey);
const inputClass = "mt-2 min-h-11 w-full rounded-xl border border-(--color-border-strong) bg-white px-4 py-3 text-(--color-foreground) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent-500)";
---

<form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="Nueva consulta desde GrupoClavD" />
  <input type="hidden" name="from_name" value="GrupoClavD Web" />
  <div class="hidden" aria-hidden="true">
    <label for="contact-botcheck">Deja este campo vacío</label>
    <input id="contact-botcheck" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="contact-name" class="font-semibold text-(--color-foreground)">Nombre <span aria-hidden="true">*</span></label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="120" class={inputClass} />
    </div>
    <div>
      <label for="contact-company" class="font-semibold text-(--color-foreground)">Empresa</label>
      <input id="contact-company" name="company" type="text" autocomplete="organization" maxlength="160" class={inputClass} />
    </div>
    <div>
      <label for="contact-email" class="font-semibold text-(--color-foreground)">Email <span aria-hidden="true">*</span></label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" class={inputClass} />
    </div>
    <div>
      <label for="contact-phone" class="font-semibold text-(--color-foreground)">Teléfono</label>
      <input id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" class={inputClass} />
    </div>
  </div>

  <div>
    <label for="contact-topic" class="font-semibold text-(--color-foreground)">Asunto <span aria-hidden="true">*</span></label>
    <input id="contact-topic" name="topic" type="text" required maxlength="160" class={inputClass} />
  </div>
  <div>
    <label for="contact-message" class="font-semibold text-(--color-foreground)">Mensaje <span aria-hidden="true">*</span></label>
    <textarea id="contact-message" name="message" required maxlength="5000" rows="7" class={inputClass}></textarea>
  </div>

  <div>
    <label for="contact-privacy" class="flex items-start gap-3 text-(--color-foreground)">
      <input id="contact-privacy" name="privacy" type="checkbox" value="Acepto el tratamiento de mis datos para responder a esta consulta" required class="mt-1 size-5 shrink-0 accent-(--color-accent-500) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent-500)" />
      <span>Acepto que GrupoClavD utilice los datos facilitados para responder a mi consulta. <span aria-hidden="true">*</span></span>
    </label>
    <p class="mt-2 pl-8 text-sm text-(--color-foreground-muted)">La política de privacidad completa está pendiente de publicación.</p>
  </div>

  <div>
    <button id="contact-submit" type="submit" disabled={!ready} class="inline-flex min-h-11 items-center justify-center rounded-xl bg-(--color-foreground) px-6 py-3 font-semibold text-white transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent-500) disabled:cursor-not-allowed disabled:opacity-50">Enviar mensaje</button>
    <p id="contact-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1" class="mt-4 text-sm font-semibold text-(--color-foreground)">
      {!ready && "El formulario estará disponible cuando se configure el servicio de envío."}
    </p>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const button = document.querySelector<HTMLButtonElement>("#contact-submit");
  const status = document.querySelector<HTMLElement>("#contact-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!button || !status || button.disabled || !form.reportValidity()) return;

    button.disabled = true;
    button.textContent = "Enviando...";
    status.textContent = "Enviando tu mensaje...";

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const result: { success?: boolean } = await response.json();
      if (!response.ok || result.success !== true) throw new Error("Submission failed");

      form.reset();
      status.textContent = "Mensaje enviado correctamente. Gracias por escribirnos.";
      status.focus();
    } catch {
      status.textContent = "No hemos podido enviar el mensaje. Revisa tus datos e inténtalo de nuevo.";
      status.focus();
    } finally {
      button.disabled = false;
      button.textContent = "Enviar mensaje";
    }
  });
</script>
