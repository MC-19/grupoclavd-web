---
import Container from "../../ui/Container.astro";
import ButtonLink from "../../ui/ButtonLink.astro";
import ResponsiveImage from "../../ui/ResponsiveImage.astro";
import { paths } from "../../../data/navigation";
import { halloweenEnabled } from "../../../config/seasonal";
import Decoration from "../../seasonal/Decoration.astro";
---

<section class:list={["py-16 lg:py-20", halloweenEnabled && "halloween-hero"]}>
  {halloweenEnabled && <Decoration kind="web" class="hero-web" />}
  <Container>
    <div class="grid items-center gap-12 min-[900px]:grid-cols-[1.1fr_0.9fr]">
      <div>
        {halloweenEnabled && <p class="halloween-hero-note"><Decoration kind="pumpkin" class="hero-pumpkin" /> Halloween también se viste de marca</p>}
        <p
          class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
        >
          Rotulación · Impresión digital · Instalación
        </p>

        <h1
          class="text-4xl font-black leading-tight text-(--color-foreground) sm:text-5xl lg:text-6xl"
        >
          Rotulación, impresión digital e{" "}
          <span class="text-(--color-accent-500)">
            instalación para empresas
          </span>
        </h1>

        <p
          class="mt-6 max-w-xl text-lg leading-relaxed text-(--color-foreground-muted)"
        >
          Trabajamos desde Elche en proyectos de rotulación, impresión digital e
          instalación para empresas y comercios. Atendemos Alicante y coordinamos
          trabajos para franquicias y cadenas en toda España.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <ButtonLink href={paths.quote}>
            Solicitar presupuesto
          </ButtonLink>

          <ButtonLink href={paths.projects} variant="secondary">
            Ver proyectos
          </ButtonLink>
        </div>
      </div>

      <div class="aspect-4/3 overflow-hidden rounded-2xl">
        <ResponsiveImage
          src="/ImagenesWebClav/Fotos%20Que%20si/fachada-escaparate-pikolinos.jpg"
          alt="Fachada y escaparate comercial rotulados de Pikolinos"
          class="h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </Container>
</section>
