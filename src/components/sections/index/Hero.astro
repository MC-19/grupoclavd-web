---
import Container from "../../ui/Container.astro";
import ButtonLink from "../../ui/ButtonLink.astro";
import { paths } from "../../../data/navigation";
---

<section class="py-16 lg:py-20">
  <Container>
    <div class="grid items-center gap-12 min-[900px]:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p
          class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
        >
          Rotulación · Impresión digital · Instalación
        </p>

        <h1
          class="text-4xl font-black leading-tight text-(--color-foreground) sm:text-5xl lg:text-6xl"
        >
          Rotulación, impresión digital e{" "}
          <span class="text-(--color-accent-500)">
            instalación para empresas
          </span>
        </h1>

        <p
          class="mt-6 max-w-xl text-lg leading-relaxed text-(--color-foreground-muted)"
        >
          Diseñamos, fabricamos e instalamos rótulos, vinilos, señalética y
          soluciones de imagen corporativa para empresas, comercios, franquicias
          y cadenas en toda España.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <ButtonLink href={paths.quote}>
            Solicitar presupuesto
          </ButtonLink>

          <ButtonLink href={paths.projects} variant="secondary">
            Ver proyectos
          </ButtonLink>
        </div>
      </div>

      <div
        class="flex min-h-95 items-center justify-center rounded-2xl bg-(--color-surface-muted)"
      >
        <span class="text-(--color-foreground-muted)">
          Imagen del proyecto
        </span>
      </div>
    </div>
  </Container>
</section>
