---
import Container from "../../ui/Container.astro";

const steps = [
  {
    number: "01",
    title: "Proyecto",
    description:
      "Analizamos las necesidades, medidas, ubicaciones y requisitos de cada trabajo para definir la solución adecuada.",
  },
  {
    number: "02",
    title: "Producción",
    description:
      "Fabricamos y producimos los elementos gráficos, rótulos, vinilos y soportes necesarios para cada proyecto.",
  },
  {
    number: "03",
    title: "Logística",
    description:
      "Coordinamos materiales, entregas y desplazamientos para proyectos puntuales o actuaciones en múltiples ubicaciones.",
  },
  {
    number: "04",
    title: "Instalación",
    description:
      "Nuestro equipo realiza el montaje e instalación final para asegurar una ejecución correcta en cada ubicación.",
  },
];
---

<section class="py-16 lg:py-24">
  <Container>
    <div class="max-w-3xl">
      <p
        class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
      >
        Servicio integral
      </p>

      <h2
        class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl"
      >
        Un único proveedor, de la fabricación a la instalación
      </h2>

      <p
        class="mt-5 max-w-2xl text-lg leading-relaxed text-(--color-foreground-muted)"
      >
        Coordinamos todo el proceso para que cada proyecto mantenga la misma
        calidad, imagen y ejecución desde la producción hasta el montaje final.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step) => (
          <article class="relative border-t-2 border-(--color-border-strong) pt-6">
            <span class="text-sm font-black tracking-[0.15em] text-(--color-accent-500)">
              {step.number}
            </span>

            <h3 class="mt-3 text-2xl font-bold text-(--color-foreground)">
              {step.title}
            </h3>

            <p class="mt-3 leading-relaxed text-(--color-foreground-muted)">
              {step.description}
            </p>
          </article>
        ))
      }
    </div>

    <div
      class="mt-12 grid gap-6 border-t border-(--color-border) pt-8 sm:grid-cols-3"
    >
      <div>
        <p class="text-3xl font-black text-(--color-accent-500) sm:text-4xl">
          +20 años
        </p>
        <p class="mt-1 font-semibold text-(--color-foreground)">
          de experiencia en el sector
        </p>
      </div>

      <div>
        <p class="text-3xl font-black text-(--color-accent-500) sm:text-4xl">
          Fabricación propia
        </p>
        <p class="mt-1 font-semibold text-(--color-foreground)">
          producción y maquinaria propias
        </p>
      </div>

      <div>
        <p class="text-3xl font-black text-(--color-accent-500) sm:text-4xl">
          Toda España
        </p>
        <p class="mt-1 font-semibold text-(--color-foreground)">
          instalación y montaje a nivel nacional
        </p>
      </div>
    </div>
  </Container>
</section>
