---
import ProjectCard from "@/components/sections/projects/ProjectCard.astro";
import Container from "@/components/ui/Container.astro";
import { featuredProjects } from "@/data/projects";
import { paths } from "@/data/navigation";

const homeProjects = featuredProjects.slice(0, 3);
---

<section class="py-16 lg:py-24">
  <Container>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">Proyectos</p>
        <h2 class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl">Proyectos de rotulación, gráfica e instalación</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-(--color-foreground-muted)">Una selección visual de trabajos en fachadas, interiores y espacios comerciales.</p>
      </div>
      <a href={paths.projects} class="group inline-flex shrink-0 items-center font-semibold text-(--color-accent-500)">
        Ver todos los proyectos <span class="ml-2 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {homeProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Container>
</section>
