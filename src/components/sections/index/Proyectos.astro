---
import { Image } from "astro:assets";

import mysoftElche from "@/assets/images/projects/PRODUCCION_Expositor_Mysoft.jpg";
import pikolinosElche from "@/assets/images/projects/TRABAJO_Fachada_Pikolinos.jpg";
import biomecanicsMadrid from "@/assets/images/projects/TRABAJOS_Expositor_Biomecanics.jpg";

import Container from "../../ui/Container.astro";

const projects = [
  {
    title: "Rotulación corporativa para Biomecanics",
    category: "Rotulación e instalación",
    location: "Madrid",
    image: biomecanicsMadrid,
    href: "/proyectos/biomecanics-madrid/",
  },
  {
    title: "Implantación de imagen para MySoft",
    category: "Producción · Logística · Montaje",
    location: "España",
    image: mysoftElche,
    href: "/proyectos/mysoft/",
  },
  {
    title: "Rotulación exterior y señalética para Pikolinos",
    category: "Fachada · Señalética",
    location: "Alicante",
    image: pikolinosElche,
    href: "/proyectos/pikolinos-alicante/",
  },
];
---

<section class="py-16 lg:py-24">
  <Container>
    <div
      class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between"
    >
      <div class="max-w-3xl">
        <p
          class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
        >
          Proyectos
        </p>

        <h2
          class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl"
        >
          Proyectos de rotulación realizados para empresas
        </h2>

        <p
          class="mt-5 max-w-2xl text-lg leading-relaxed text-(--color-foreground-muted)"
        >
          Fabricación, producción gráfica e instalación para proyectos de imagen
          corporativa de diferentes escalas y ubicaciones.
        </p>
      </div>

      <a
        href="/proyectos/"
        class="group inline-flex shrink-0 items-center font-semibold text-(--color-accent-500)"
      >
        Ver todos los proyectos

        <span
          class="ml-2 transition-transform duration-200 group-hover:translate-x-1"
          aria-hidden="true"
        >
          →
        </span>
      </a>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        projects.map((project) => (
          <a
            href={project.href}
            class="group flex h-full flex-col overflow-hidden rounded-2xl border border-(--color-border) bg-white transition duration-300 hover:-translate-y-1 hover:shadow-lg"
          >
            <div class="aspect-4/3 overflow-hidden bg-(--color-surface-muted)">
              <Image
                src={project.image}
                alt={project.title}
                widths={[400, 600, 800]}
                sizes="(min-width: 1024px) 33vw, 100vw"
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
            </div>

            <div class="flex flex-1 flex-col p-6">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-semibold text-(--color-foreground-muted)">
                <span>{project.category}</span>

                <span aria-hidden="true">·</span>

                <span>{project.location}</span>
              </div>

              <h3 class="mt-3 text-xl font-bold leading-snug text-(--color-foreground) transition group-hover:text-(--color-accent-500)">
                {project.title}
              </h3>

              <span class="mt-auto inline-flex items-center pt-5 font-semibold text-(--color-accent-500)">
                Ver proyecto
                <span
                  class="ml-2 transition-transform duration-200 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  →
                </span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </Container>
</section>
