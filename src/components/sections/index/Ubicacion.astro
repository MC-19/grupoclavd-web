---
import Container from "../../ui/Container.astro";
import { paths } from "../../../data/navigation";

const highlights = [
  "Proyectos en todo el territorio nacional",
  "Coordinación de múltiples ubicaciones",
  "Fabricación, logística e instalación",
];

const coverageAreas = [
  { name: "Península", detail: "Cobertura operativa" },
  { name: "Baleares y Canarias", detail: "Cobertura insular" },
  { name: "Ceuta y Melilla", detail: "Cobertura nacional" },
];
---

<section class="bg-(--color-surface-muted) py-16 lg:py-24">
  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">
          Cobertura nacional
        </p>

        <h2 class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl">
          Rotulación e instalación en toda España
        </h2>

        <p class="mt-5 max-w-xl text-lg leading-relaxed text-(--color-foreground-muted)">
          Hemos realizado proyectos de rotulación, imagen corporativa e
          instalación en todo el territorio nacional para empresas con una o
          múltiples ubicaciones.
        </p>

        <p class="mt-4 max-w-xl leading-relaxed text-(--color-foreground-muted)">
          Coordinamos la producción, logística y montaje en Península, Baleares,
          Canarias, Ceuta y Melilla, manteniendo una ejecución homogénea en cada
          establecimiento.
        </p>

        <ul class="mt-8 max-w-full space-y-4">
          {
            highlights.map((item) => (
              <li class="flex items-start gap-3">
                <span
                  class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-(--color-accent-500) text-sm font-bold text-white"
                  aria-hidden="true"
                >
                  ✓
                </span>
                <span class="min-w-0 text-sm font-semibold leading-relaxed text-(--color-foreground) sm:text-base">
                  {item}
                </span>
              </li>
            ))
          }
        </ul>

        <a
          href={paths.contact}
          class="group mt-8 inline-flex items-center font-semibold text-(--color-accent-500)"
        >
          Cuéntanos tu proyecto
          <span
            class="ml-2 transition-transform duration-200 group-hover:translate-x-1"
            aria-hidden="true"
          >
            →
          </span>
        </a>
      </div>

      <div class="relative overflow-hidden rounded-3xl bg-(--color-foreground) p-6 text-white shadow-lg sm:p-8 lg:p-10">
        <div
          class="pointer-events-none absolute inset-0 opacity-[0.07]"
          aria-hidden="true"
          style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 22px 22px;"
        >
        </div>
        <div
          class="pointer-events-none absolute -right-20 -top-24 size-72 rounded-full bg-(--color-accent-500)/25 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <div
          class="pointer-events-none absolute -bottom-32 -left-24 size-80 rounded-full bg-(--color-primary-500)/20 blur-3xl"
          aria-hidden="true"
        >
        </div>

        <div class="relative">
          <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:gap-5">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-(--color-accent-300)">
                Área de actuación
              </p>
              <p class="mt-2 text-2xl font-black sm:text-3xl">
                Cobertura nacional
              </p>
            </div>

            <span class="shrink-0 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-bold text-white/80">
              Toda España
            </span>
          </div>

          <img
            src="/images/spain-coverage-map.svg"
            alt="Mapa de cobertura de GrupoClavD en Península, Baleares, Canarias, Ceuta y Melilla"
            width="760"
            height="500"
            class="mt-5 h-auto w-full"
            loading="lazy"
            decoding="async"
          />

          <div class="mt-2 grid border-t border-white/15 sm:grid-cols-3">
            {
              coverageAreas.map((area) => (
                <div class="border-white/15 py-4 sm:border-r sm:px-4 sm:first:pl-0 sm:last:border-r-0 sm:last:pr-0">
                  <p class="text-sm font-bold text-white">{area.name}</p>
                  <p class="mt-1 text-xs text-white/55">{area.detail}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
