---
import Container from "../../ui/Container.astro";

const faqs = [
  {
    question: "¿Trabajáis en toda España?",
    answer:
      "Sí. Realizamos proyectos de rotulación e instalación en todo el territorio nacional, incluyendo Península, Baleares, Canarias, Ceuta y Melilla.",
  },
  {
    question: "¿Os encargáis tanto de la fabricación como de la instalación?",
    answer:
      "Sí. Podemos gestionar el proyecto completo, desde la fabricación y producción gráfica hasta la coordinación logística y la instalación final.",
  },
  {
    question: "¿Trabajáis con empresas con múltiples establecimientos?",
    answer:
      "Sí. Coordinamos proyectos para empresas, cadenas y franquicias que necesitan actuar en varias ubicaciones manteniendo una imagen corporativa homogénea.",
  },
  {
    question: "¿Qué tipos de trabajos de rotulación realizáis?",
    answer:
      "Realizamos rótulos, letras corpóreas, fachadas, vinilos, señalética, rotulación de vehículos y otras soluciones de imagen corporativa para empresas.",
  },
  {
    question: "¿Cómo puedo solicitar presupuesto para un proyecto?",
    answer:
      "Puedes contactar con nuestro equipo indicando el tipo de trabajo, la ubicación y las necesidades del proyecto. Estudiaremos el trabajo para ofrecerte una solución adaptada.",
  },
];
---

<section class="py-16 lg:py-24">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
      <!-- Introducción -->
      <div>
        <p
          class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
        >
          Preguntas frecuentes
        </p>

        <h2
          class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl"
        >
          Resolvemos tus dudas antes de empezar
        </h2>

        <p
          class="mt-5 max-w-md text-lg leading-relaxed text-(--color-foreground-muted)"
        >
          Si estás valorando un proyecto de rotulación, impresión o instalación,
          estas son algunas de las preguntas que recibimos con más frecuencia.
        </p>

        <div class="mt-8">
          <p class="font-semibold text-(--color-foreground)">
            ¿Tienes otra pregunta?
          </p>

          <a
            href="/contacto/"
            class="group mt-2 inline-flex items-center font-semibold text-(--color-accent-500)"
          >
            Habla con nosotros

            <span
              class="ml-2 transition-transform duration-200 group-hover:translate-x-1"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="border-t border-(--color-border)">
        {
          faqs.map((faq) => (
            <details class="group border-b border-(--color-border)">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 font-bold text-(--color-foreground)">
                <span class="text-lg">{faq.question}</span>

                <span
                  class="relative flex size-8 shrink-0 items-center justify-center rounded-full bg-(--color-surface-muted)"
                  aria-hidden="true"
                >
                  <span class="absolute h-0.5 w-3.5 bg-(--color-foreground)" />

                  <span class="absolute h-3.5 w-0.5 bg-(--color-foreground) transition-transform duration-200 group-open:rotate-90" />
                </span>
              </summary>

              <div class="max-w-2xl pb-6 pr-12">
                <p class="leading-relaxed text-(--color-foreground-muted)">
                  {faq.answer}
                </p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </Container>
</section>
