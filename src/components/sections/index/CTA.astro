---
import Container from "../../ui/Container.astro";
import ButtonLink from "../../ui/ButtonLink.astro";
import { paths } from "../../../data/navigation";
---

<section class="py-16 lg:py-24">
  <Container>
    <div
      class="relative overflow-hidden rounded-3xl bg-(--color-foreground) px-6 py-12 sm:px-10 lg:px-16 lg:py-16"
    >
      <!-- Decoración -->
      <div
        class="pointer-events-none absolute -right-24 -top-24 size-72 rounded-full bg-(--color-accent-500)/20 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div
        class="pointer-events-none absolute -bottom-24 -left-24 size-72 rounded-full bg-(--color-primary-500)/20 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between"
      >
        <div class="max-w-3xl">
          <p
            class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
          >
            Cuéntanos tu proyecto
          </p>

          <h2
            class="text-3xl font-black leading-tight text-white sm:text-4xl lg:text-5xl"
          >
            ¿Necesitas rotulación, impresión o instalación?
          </h2>

          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/70">
            Explícanos qué necesitas y nuestro equipo estudiará tu proyecto para
            ofrecerte una solución adaptada, desde la fabricación hasta la
            instalación final.
          </p>
        </div>

        <div class="flex shrink-0 flex-col gap-3 sm:flex-row lg:flex-col">
          <ButtonLink href={paths.quote} class="px-7 py-3.5">
            Solicitar presupuesto
          </ButtonLink>

          <ButtonLink href={paths.contact} variant="inverse" class="px-7 py-3.5">
            Contactar
          </ButtonLink>
        </div>
      </div>
    </div>
  </Container>
</section>
