---
import Container from "@/components/ui/Container.astro";
import type { DigitalPrintingHubPage } from "@/data/digitalPrinting";

interface Props { page: DigitalPrintingHubPage }
const { page } = Astro.props;
---

<section class="py-16 lg:py-20">
  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div class="aspect-4/3 overflow-hidden rounded-2xl bg-(--color-surface-muted)">
        <img src={page.customization.image} alt={page.customization.imageAlt} class="h-full w-full object-cover" loading="lazy" decoding="async" />
      </div>
      <div>
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">{page.customization.eyebrow}</p>
        <h2 class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl">{page.customization.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-(--color-foreground-muted)">{page.customization.intro}</p>
        <div class="mt-8 grid gap-x-10 gap-y-7 sm:grid-cols-2">
          {page.customization.points.map((point) => (
            <div class="border-t border-(--color-border) pt-5">
              <h3 class="text-lg font-bold text-(--color-foreground)">{point.title}</h3>
              <p class="mt-2 leading-relaxed text-(--color-foreground-muted)">{point.description}</p>
            </div>
          ))}
        </div>
        <div class="mt-8 border-t border-(--color-border) pt-5">
          <h3 class="text-lg font-bold text-(--color-foreground)">{page.installation.title}</h3>
          <p class="mt-2 leading-relaxed text-(--color-foreground-muted)">{page.installation.intro}</p>
        </div>
      </div>
    </div>
  </Container>
</section>
