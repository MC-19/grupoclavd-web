---
import Container from "@/components/ui/Container.astro";
import type { DigitalPrintingHubPage, DigitalPrintingDetailPage } from "@/data/digitalPrinting";

interface Props {
  page: DigitalPrintingHubPage | DigitalPrintingDetailPage;
  variant: "hub" | "list" | "cards";
}
const { page, variant } = Astro.props;
---

<section id="soluciones-impresion-digital" class="bg-(--color-surface-muted) py-16 lg:py-20">
  <Container>
    <div class="max-w-3xl">
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">{page.solutions.eyebrow}</p>
      <h2 class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl">{page.solutions.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-(--color-foreground-muted)">{page.solutions.intro}</p>
    </div>
    {variant === "hub" ? (
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {page.solutions.items.map((item) => (
          <a href={item.href} class="group flex h-full flex-col overflow-hidden rounded-2xl border border-(--color-border) bg-white transition duration-300 hover:-translate-y-1 hover:shadow-lg">
            <div class="aspect-16/10 overflow-hidden bg-white">
              <img src={item.image} alt={item.imageAlt} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl font-bold text-(--color-foreground) transition group-hover:text-(--color-accent-500)">{item.title}</h3>
              <p class="mt-3 leading-relaxed text-(--color-foreground-muted)">{item.description}</p>
              <span class="mt-auto inline-flex items-center pt-5 font-semibold text-(--color-accent-500)">Ver servicio <span class="ml-2 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    ) : variant === "cards" ? (
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {page.solutions.items.map((item) => (
          <article class="rounded-2xl border border-(--color-border) bg-white p-6 sm:p-7">
            <h3 class="text-xl font-bold text-(--color-foreground)">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-(--color-foreground-muted)">{item.description}</p>
          </article>
        ))}
      </div>
    ) : (
      <div class="mt-12 border-t border-(--color-border)">
        {page.solutions.items.map((item) => (
          <article class="grid gap-5 border-b border-(--color-border) py-8 md:grid-cols-[0.8fr_1.2fr] md:gap-8 lg:py-10">
            <h3 class="text-xl font-bold text-(--color-foreground) sm:text-2xl">{item.title}</h3>
            <p class="max-w-2xl leading-relaxed text-(--color-foreground-muted)">{item.description}</p>
          </article>
        ))}
      </div>
    )}
  </Container>
</section>
