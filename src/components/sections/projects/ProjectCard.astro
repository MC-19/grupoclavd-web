---
import type { Project } from "@/data/projects";
import { projectHref } from "@/data/projects";

interface Props { project: Project; priority?: boolean }
const { project, priority = false } = Astro.props;
const href = projectHref(project);
---

{href ? (
  <a href={href} class="group flex h-full flex-col overflow-hidden rounded-2xl border border-(--color-border) bg-white transition duration-300 hover:-translate-y-1 hover:shadow-lg">
    <div class="aspect-4/3 overflow-hidden bg-(--color-surface-muted)">
      <img src={project.cover} alt={project.coverAlt} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading={priority ? "eager" : "lazy"} decoding="async" />
    </div>
    <div class="flex flex-1 flex-col p-6">
      <p class="text-sm font-semibold text-(--color-accent-500)">{project.category}</p>
      <h3 class="mt-3 text-xl font-bold leading-snug text-(--color-foreground) transition group-hover:text-(--color-accent-500)">{project.title}</h3>
      <p class="mt-3 flex-1 leading-relaxed text-(--color-foreground-muted)">{project.summary}</p>
      <span class="mt-5 inline-flex items-center font-semibold text-(--color-accent-500)">Ver proyecto <span class="ml-2 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span></span>
    </div>
  </a>
) : (
  <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-(--color-border) bg-white">
    <div class="aspect-4/3 overflow-hidden bg-(--color-surface-muted)">
      <img src={project.cover} alt={project.coverAlt} class="h-full w-full object-cover" loading="lazy" decoding="async" />
    </div>
    <div class="flex flex-1 flex-col p-6">
      <p class="text-sm font-semibold text-(--color-accent-500)">{project.category}</p>
      <h3 class="mt-3 text-xl font-bold leading-snug text-(--color-foreground)">{project.title}</h3>
      <p class="mt-3 leading-relaxed text-(--color-foreground-muted)">{project.summary}</p>
    </div>
  </article>
)}
