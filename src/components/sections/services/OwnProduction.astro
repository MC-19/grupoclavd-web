---
import Container from "@/components/ui/Container.astro";

const capabilities = [
  "Fabricación propia",
  "Maquinaria y medios de producción",
  "Equipos de instalación",
  "Coordinación logística",
];
---

<section class="bg-(--color-surface-muted) py-16 lg:py-24">
  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <p
          class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
        >
          Capacidad propia
        </p>

        <h2
          class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl"
        >
          Fabricación propia y montaje en toda España
        </h2>

        <p
          class="mt-5 max-w-xl text-lg leading-relaxed text-(--color-foreground-muted)"
        >
          Contamos con medios de producción propios para fabricar y preparar los
          elementos de cada proyecto, coordinando después su logística e
          instalación.
        </p>

        <p
          class="mt-4 max-w-xl leading-relaxed text-(--color-foreground-muted)"
        >
          Esto nos permite gestionar el proceso de forma centralizada y mantener
          una ejecución homogénea en proyectos puntuales o en múltiples
          ubicaciones.
        </p>

        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            capabilities.map((item) => (
              <li class="flex items-start gap-3">
                <span
                  class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-(--color-accent-500) text-sm font-bold text-white"
                  aria-hidden="true"
                >
                  ✓
                </span>

                <span class="font-semibold text-(--color-foreground)">
                  {item}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="aspect-4/3 overflow-hidden rounded-2xl bg-white">
        <div
          class="flex h-full items-center justify-center text-(--color-foreground-muted)"
        >
          Foto de taller, maquinaria o producción
        </div>
      </div>
    </div>
  </Container>
</section>
