---
import Container from "@/components/ui/Container.astro";
import { serviceAdvice } from "@/data/serviceAdvice";
import { paths } from "@/data/navigation";

const advice = serviceAdvice[`${Astro.url.pathname.replace(/\/$/, "")}/`];
---

{advice && (
  <section class="py-16 lg:py-20" aria-labelledby="preparar-presupuesto">
    <Container>
      <div class="max-w-3xl">
        <h2 id="preparar-presupuesto" class="text-3xl font-black text-(--color-foreground)">Qué necesitamos para valorar tu proyecto</h2>
        <p class="mt-5 text-lg leading-relaxed text-(--color-foreground-muted)">{advice.preparation}</p>
        <p class="mt-5 leading-relaxed"><a href={paths.contact} class="font-semibold text-(--color-accent-500) underline underline-offset-4">Enviar una consulta sobre este trabajo</a> o <a href={paths.quote} class="font-semibold text-(--color-accent-500) underline underline-offset-4">preparar una solicitud de presupuesto</a>.</p>
        <h2 class="mt-10 text-2xl font-black text-(--color-foreground)">Preguntas antes de encargar el trabajo</h2>
        <div class="mt-5 divide-y divide-(--color-border)">
          {advice.questions.map(({ question, answer }) => (
            <details class="py-5">
              <summary class="cursor-pointer text-lg font-bold text-(--color-foreground)">{question}</summary>
              <p class="mt-4 leading-relaxed text-(--color-foreground-muted)">{answer}</p>
            </details>
          ))}
        </div>
        <aside class="mt-8" aria-label="Guías para preparar el proyecto">
          <p class="font-bold text-(--color-foreground)">Para preparar el encargo</p>
          <ul class="mt-3 space-y-3">
            {advice.guides.map((guide) => <li><a href={`${paths.blog}${guide.slug}/`} class="font-semibold text-(--color-accent-500) underline underline-offset-4">{guide.label}</a></li>)}
          </ul>
        </aside>
      </div>
    </Container>
  </section>
)}
