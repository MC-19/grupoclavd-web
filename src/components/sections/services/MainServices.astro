---
import Container from "@/components/ui/Container.astro";

const services = [
  {
    number: "01",
    title: "Rotulación",
    description:
      "Diseñamos y fabricamos soluciones de rotulación para empresas, comercios, franquicias y cadenas.",
    items: [
      "Letras corpóreas",
      "Rótulos luminosos",
      "Fachadas",
      "Vehículos",
      "Vinilos",
      "Señalética",
    ],
    href: "/servicios/rotulacion/",
  },
  {
    number: "02",
    title: "Impresión digital",
    description:
      "Producimos gráfica de gran formato para campañas, espacios comerciales y proyectos de imagen corporativa.",
    items: [
      "Gran formato",
      "Lonas",
      "Cartelería",
      "Vinilos impresos",
      "Soportes rígidos",
      "Displays",
    ],
    href: "/servicios/impresion-digital/",
  },
  {
    number: "03",
    title: "Instalación y montaje",
    description:
      "Coordinamos e instalamos elementos de comunicación visual en proyectos puntuales y actuaciones en múltiples ubicaciones.",
    items: [
      "Montaje de rótulos",
      "Instalación de vinilos",
      "Fachadas",
      "Señalética",
      "Vallas",
      "Implantaciones nacionales",
    ],
    href: "/servicios/instalacion-montaje/",
  },
];
---

<section class="bg-(--color-surface-muted) py-16 lg:py-24">
  <Container>
    <div class="max-w-3xl">
      <p
        class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
      >
        Qué hacemos
      </p>

      <h2
        class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl"
      >
        Tres áreas para cubrir todo tu proyecto
      </h2>

      <p
        class="mt-5 max-w-2xl text-lg leading-relaxed text-(--color-foreground-muted)"
      >
        Fabricación, producción gráfica e instalación coordinadas para dar
        respuesta a proyectos de cualquier escala.
      </p>
    </div>

    <div class="mt-12 border-t border-(--color-border)">
      {
        services.map((service) => (
          <article class="grid gap-6 border-b border-(--color-border) py-9 lg:grid-cols-[100px_1fr_1fr_auto] lg:items-start lg:gap-10 lg:py-10">
            <span class="text-sm font-black tracking-[0.15em] text-(--color-accent-500)">
              {service.number}
            </span>

            <div>
              <h3 class="text-2xl font-black text-(--color-foreground) sm:text-3xl">
                {service.title}
              </h3>

              <p class="mt-3 max-w-xl leading-relaxed text-(--color-foreground-muted)">
                {service.description}
              </p>
            </div>

            <ul class="flex flex-wrap gap-x-2 gap-y-2 lg:max-w-md">
              {service.items.map((item) => (
                <li class="rounded-full bg-white px-3 py-1.5 text-sm font-semibold text-(--color-foreground-muted)">
                  {item}
                </li>
              ))}
            </ul>

            <a
              href={service.href}
              class="group inline-flex shrink-0 items-center font-bold text-(--color-accent-500) lg:pt-1"
            >
              Ver servicio
              <span
                class="ml-2 transition-transform duration-200 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </article>
        ))
      }
    </div>
  </Container>
</section>
