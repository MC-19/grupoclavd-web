---
import type { BlogArticle } from "@/data/blog";
import ResponsiveImage from "@/components/ui/ResponsiveImage.astro";

interface Props {
  article: BlogArticle;
  prominent?: boolean;
}

const { article, prominent = false } = Astro.props;
---

<article class:list={["group relative flex h-full flex-col overflow-hidden rounded-2xl border bg-white p-6 transition duration-300 hover:-translate-y-1 hover:shadow-lg", prominent ? "border-(--color-border-strong)" : "border-(--color-border)"]}>
  <span class:list={["absolute inset-x-0 top-0 h-1 bg-(--gradient-brand)", !prominent && "opacity-0 transition group-hover:opacity-100"]} aria-hidden="true"></span>
  {article.image && article.imageAlt && <ResponsiveImage src={article.image} alt={article.imageAlt} width={960} height={540} class="mb-6 aspect-16/9 w-full rounded-xl object-cover" sizes="(min-width: 768px) 50vw, 100vw" />}
  <p><span class="inline-flex rounded-full bg-(--color-accent-50) px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] text-(--color-accent-700)">{article.category}</span></p>
  <h3 class="mt-3 text-xl font-black leading-tight text-(--color-foreground) sm:text-2xl">
    <a href={`/blog/${article.slug}/`} class="rounded-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--color-accent-500) group-hover:text-(--color-accent-600)">{article.title}</a>
  </h3>
  <p class="mt-4 flex-1 leading-relaxed text-(--color-foreground-muted)">{article.description}</p>
  <div class="mt-6 border-t border-(--color-border) pt-5">
    <a href={`/blog/${article.slug}/`} aria-label={`Leer artículo: ${article.title}`} class="inline-flex min-h-11 items-center font-semibold text-(--color-accent-500) underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent-500)">Leer artículo <span class="ml-2 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span></a>
  </div>
</article>
