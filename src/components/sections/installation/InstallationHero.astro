---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Container from "@/components/ui/Container.astro";
import { paths } from "@/data/navigation";
---

<section class="py-12 lg:py-16">
  <Container>
    <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div>
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">Instalación y montaje</p>
        <h1 class="text-4xl font-black leading-tight text-(--color-foreground) sm:text-5xl lg:text-6xl">Instalación y montaje para empresas</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-(--color-foreground-muted)">
          Instalamos y coordinamos elementos de comunicación visual para que la imagen de tu empresa se integre en fachadas, interiores y espacios comerciales.
        </p>
        <div class="mt-7 flex flex-wrap gap-4">
          <ButtonLink href={paths.quote}>Solicitar presupuesto</ButtonLink>
          <ButtonLink href="#que-instalamos" variant="secondary">Ver qué instalamos</ButtonLink>
        </div>
      </div>
      <div class="aspect-4/3 overflow-hidden rounded-2xl bg-(--color-surface-muted)">
        <img src="/ImagenesWebClav/Fotos%20Nuevas/instalacion-letras-alcampo-fachada.jpeg" alt="Instalación de letras de Alcampo en una fachada" class="h-full w-full object-cover" loading="eager" decoding="async" fetchpriority="high" />
      </div>
    </div>
  </Container>
</section>
