---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Container from "@/components/ui/Container.astro";
import { paths } from "@/data/navigation";
---

<section class="py-12 lg:py-16">
  <Container>
    <div class="mx-auto max-w-4xl text-center">
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">Comunicación en el punto de venta</p>
      <h1 class="text-4xl font-black leading-tight text-(--color-foreground) sm:text-5xl lg:text-6xl">Rotulación de escaparates para empresas</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-(--color-foreground-muted)">
        Desarrollamos soluciones gráficas para escaparates comerciales que comunican campañas, promociones e identidad de marca en relación con cada establecimiento.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-4">
        <ButtonLink href={paths.quote}>Solicitar presupuesto</ButtonLink>
        <ButtonLink href="#objetivos-escaparate" variant="secondary">Ver soluciones</ButtonLink>
      </div>
    </div>
    <div class="mt-12 aspect-16/7 overflow-hidden rounded-2xl">
      <img
        src="/ImagenesWebClav/Fotos%20Que%20si/escaparate-pikolinos-centro-comercial.jpg"
        alt="Escaparate comercial de Pikolinos con gráfica de campaña"
        class="h-full w-full object-cover"
        loading="eager"
        decoding="async"
      />
    </div>
  </Container>
</section>
