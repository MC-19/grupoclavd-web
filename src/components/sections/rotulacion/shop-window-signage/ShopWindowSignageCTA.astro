---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Container from "@/components/ui/Container.astro";
import { paths } from "@/data/navigation";
---

<section class="py-16 lg:py-20">
  <Container>
    <div class="rounded-3xl bg-(--color-foreground) px-6 py-10 text-center sm:px-10 lg:px-16 lg:py-14">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-400)">Cuéntanos tu idea</p>
      <h2 class="mx-auto mt-3 max-w-3xl text-3xl font-black leading-tight text-white sm:text-4xl lg:text-5xl">¿Quieres renovar o rotular el escaparate de tu negocio?</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white/70">
        Explícanos qué quieres comunicar y cómo es tu escaparate. Estudiaremos una propuesta gráfica adaptada a tu marca y al espacio.
      </p>
      <div class="mt-8 flex justify-center"><ButtonLink href={paths.quote}>Solicitar presupuesto</ButtonLink></div>
    </div>
  </Container>
</section>
