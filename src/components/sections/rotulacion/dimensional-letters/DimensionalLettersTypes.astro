---
import Container from "@/components/ui/Container.astro";

const letterTypes = [
  {
    title: "Letras corpóreas para fachadas",
    description:
      "Soluciones de identificación exterior adaptadas a la imagen del establecimiento y a las características de su fachada.",
  },
  {
    title: "Letras corpóreas para interiores",
    description:
      "Elementos con volumen para reforzar la presencia de marca en espacios interiores y zonas de atención.",
  },
  {
    title: "Letras corpóreas luminosas",
    description:
      "Letras con iluminación para destacar la identidad visual y favorecer su presencia en distintos entornos.",
  },
  {
    title: "Letras corpóreas sin iluminación",
    description:
      "Una solución de rotulación con volumen para proyectos que no requieren incorporar iluminación.",
  },
  {
    title: "Logotipos corpóreos",
    description:
      "Adaptación de logotipos y otros elementos de identidad visual a formatos con relieve y presencia física.",
  },
  {
    title: "Composiciones para espacios comerciales",
    description:
      "Soluciones que integran letras y elementos de identidad para presentar la marca de forma coherente dentro del espacio.",
  },
];
---

<section
  id="tipos-letras-corporeas"
  class="bg-(--color-surface-muted) py-16 lg:py-20"
>
  <Container>
    <div class="max-w-3xl">
      <p
        class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
      >
        Soluciones con volumen
      </p>

      <h2
        class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl"
      >
        Soluciones de letras corpóreas
      </h2>

      <p
        class="mt-5 max-w-2xl text-lg leading-relaxed text-(--color-foreground-muted)"
      >
        Cada solución se plantea según su ubicación, la identidad visual de la
        empresa y el efecto que se busca conseguir en el espacio.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        letterTypes.map((letterType) => (
          <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-(--color-border) bg-white">
            <div
              class="flex aspect-16/10 items-center justify-center bg-(--color-surface-muted) px-6 text-center text-sm font-semibold text-(--color-foreground-muted)"
              role="img"
              aria-label={`Espacio reservado para una imagen de ${letterType.title.toLowerCase()}`}
            >
              Imagen de {letterType.title.toLowerCase()}
            </div>

            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl font-bold text-(--color-foreground)">
                {letterType.title}
              </h3>

              <p class="mt-3 leading-relaxed text-(--color-foreground-muted)">
                {letterType.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>
