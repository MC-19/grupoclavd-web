---
import Container from "@/components/ui/Container.astro";

const solutions = [
  { number: "01", title: "Señalética direccional", description: "Indica recorridos y ayuda a localizar accesos, áreas y puntos de interés dentro de un espacio." },
  { number: "02", title: "Identificación de espacios", description: "Distingue zonas, salas o servicios para que cada lugar resulte fácil de reconocer." },
  { number: "03", title: "Señalética informativa", description: "Presenta mensajes útiles de forma clara y ordenada en los puntos donde se necesitan." },
];
---

<section id="soluciones-senaletica" class="bg-(--color-surface-muted) py-16 lg:py-20">
  <Container>
    <div class="max-w-3xl">
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">Qué necesita comunicar el espacio</p>
      <h2 class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl">Soluciones de señalética para empresas</h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-(--color-foreground-muted)">
        Organizamos la señalización según su función. Cada solución puede integrarse en entornos interiores o exteriores según las necesidades del proyecto.
      </p>
    </div>
    <div class="mt-12 border-t border-(--color-border)">
      {solutions.map((solution) => (
        <article class="grid gap-5 border-b border-(--color-border) py-8 md:grid-cols-[80px_0.8fr_1.2fr] md:gap-8 lg:py-10">
          <span class="text-sm font-black tracking-[0.15em] text-(--color-accent-500)">{solution.number}</span>
          <h3 class="text-2xl font-black text-(--color-foreground)">{solution.title}</h3>
          <p class="max-w-2xl leading-relaxed text-(--color-foreground-muted)">{solution.description}</p>
        </article>
      ))}
    </div>
  </Container>
</section>
