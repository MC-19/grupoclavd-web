---
import Container from "@/components/ui/Container.astro";

const functions = [
  { title: "Guiar recorridos", description: "Ayuda a entender hacia dónde dirigirse y cómo continuar dentro del entorno." },
  { title: "Reconocer zonas", description: "Permite identificar áreas y destinos sin depender de explicaciones adicionales." },
  { title: "Encontrar información", description: "Sitúa los mensajes donde pueden ayudar a comprender el uso del espacio." },
];
---

<section class="bg-(--color-foreground) py-16 text-white lg:py-20">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-400)">Orientación e identificación</p>
        <h2 class="text-3xl font-black leading-tight sm:text-4xl lg:text-5xl">Un espacio más fácil de entender</h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/70">
          Una señalética coherente conecta los mensajes entre sí: ayuda a orientarse, reconocer cada zona y encontrar la información necesaria durante el recorrido.
        </p>
      </div>
      <div class="border-t border-white/20">
        {functions.map((item) => (
          <article class="border-b border-white/20 py-6">
            <h3 class="text-xl font-bold">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-white/70">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </Container>
</section>
