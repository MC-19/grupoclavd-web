---
import Container from "@/components/ui/Container.astro";

const points = [
  { title: "Ubicación de cada señal", description: "La colocación tiene en cuenta dónde se necesita consultar cada mensaje dentro del recorrido." },
  { title: "Alineación y lectura", description: "Los elementos se sitúan respetando la composición y la lectura prevista para cada zona." },
  { title: "Coherencia del conjunto", description: "La instalación mantiene una relación visual entre las distintas señales y el entorno." },
];
---

<section class="bg-(--color-surface-muted) py-16 lg:py-20">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">Colocación final</p>
        <h2 class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl">Instalación de señalética</h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-(--color-foreground-muted)">
          Instalamos las señales según su ubicación y función, cuidando la alineación y su integración visual en el espacio.
        </p>
      </div>
      <div class="border-t border-(--color-border)">
        {points.map((point) => (
          <article class="border-b border-(--color-border) py-6">
            <h3 class="text-xl font-bold text-(--color-foreground)">{point.title}</h3>
            <p class="mt-3 max-w-xl leading-relaxed text-(--color-foreground-muted)">{point.description}</p>
          </article>
        ))}
      </div>
    </div>
  </Container>
</section>
