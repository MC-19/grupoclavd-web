---
import Container from "@/components/ui/Container.astro";
import { paths } from "@/data/navigation";

const services = [
  {
    title: "Fachadas y rótulos luminosos",
    description:
      "Diseño, fabricación e instalación de rótulos y elementos luminosos para fachadas comerciales y corporativas.",
    href: paths.illuminatedSigns,
    image: "/ImagenesWebClav/Fotos%20Nuevas/rotulo-iluminado-mimma-gallery-noche.jpeg",
    imageAlt: "Rótulo iluminado de MIMMA Gallery en una fachada",
  },
  {
    title: "Letras corpóreas",
    description:
      "Letras corpóreas para fachadas, interiores, comercios y espacios corporativos, adaptadas a la imagen de cada marca.",
    href: paths.dimensionalLetters,
    image: "/ImagenesWebClav/Fotos%20Nuevas/letras-corporeas-mimma-gallery-fachada.jpeg",
    imageAlt: "Letras corpóreas de MIMMA Gallery instaladas en una fachada",
  },
  {
    title: "Rotulación de vehículos y flotas",
    description:
      "Rotulación mediante vinilos para vehículos comerciales y flotas, desde actuaciones individuales hasta implantaciones de mayor escala.",
    href: paths.vehicles,
    image: "/ImagenesWebClav/Fotos%20Nuevas/rotulacion-furgoneta-ribera-valldigna.jpeg",
    imageAlt: "Furgoneta con gráfica de colores aplicada en el lateral",
  },
  {
    title: "Vinilos",
    description:
      "Vinilos de corte e impresión para escaparates, paredes, cristales, superficies comerciales y campañas promocionales.",
    href: paths.vinyls,
    image: "/ImagenesWebClav/Fotos%20Nuevas/vinilo-cristales-oficina.jpeg",
    imageAlt: "Gráfica de vinilo azul aplicada sobre cristales de una oficina",
  },
  {
    title: "Señalética",
    description:
      "Soluciones de señalización interior y exterior para empresas, establecimientos y espacios corporativos.",
    href: paths.wayfinding,
    image: "/ImagenesWebClav/Fotos%20Nuevas/senaletica-exterior-thrifty-aparcamiento.jpeg",
    imageAlt: "Señal de identificación Thrifty en un aparcamiento",
  },
  {
    title: "Escaparates",
    description:
      "Rotulación y gráfica promocional para escaparates, campañas comerciales y puntos de venta.",
    href: paths.shopWindows,
    image: "/ImagenesWebClav/Fotos%20Que%20si/escaparate-pikolinos-centro-comercial.jpg",
    imageAlt: "Escaparate de Pikolinos con gráfica comercial",
  },
];
---

<section
  id="tipos-rotulacion"
  class="bg-(--color-surface-muted) py-16 lg:py-20"
>
  <Container>
    <div class="max-w-3xl">
      <p
        class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
      >
        Soluciones de rotulación
      </p>

      <h2
        class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl"
      >
        Tipos de rotulación para empresas
      </h2>

      <p
        class="mt-5 max-w-2xl text-lg leading-relaxed text-(--color-foreground-muted)"
      >
        Desarrollamos soluciones de rotulación adaptadas a fachadas, vehículos,
        espacios comerciales e interiores, desde la fabricación hasta su
        instalación final.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <a
            href={service.href}
            class="group flex h-full flex-col overflow-hidden rounded-2xl border border-(--color-border) bg-white transition duration-300 hover:-translate-y-1 hover:shadow-lg"
          >
            <div class="aspect-16/10 overflow-hidden bg-white">
              {service.image ? (
                <img
                  src={service.image}
                  alt={service.imageAlt}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />
              ) : (
                <div class="flex h-full items-center justify-center text-sm font-semibold text-(--color-foreground-muted)">
                  Imagen del servicio
                </div>
              )}
            </div>

            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl font-bold text-(--color-foreground) transition group-hover:text-(--color-accent-500)">
                {service.title}
              </h3>

              <p class="mt-3 leading-relaxed text-(--color-foreground-muted)">
                {service.description}
              </p>

              <span class="mt-auto inline-flex items-center pt-5 font-semibold text-(--color-accent-500)">
                Ver servicio
                <span
                  class="ml-2 transition-transform duration-200 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  →
                </span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </Container>
</section>
