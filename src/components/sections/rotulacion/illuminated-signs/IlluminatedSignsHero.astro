---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Container from "@/components/ui/Container.astro";
import { paths } from "@/data/navigation";
---

<section class="py-12 lg:py-16">
  <Container>
    <div
      class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16"
    >
      <div>
        <p
          class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
        >
          Rótulos luminosos y fachadas
        </p>

        <h1
          class="text-4xl font-black leading-tight text-(--color-foreground) sm:text-5xl lg:text-6xl"
        >
          Rótulos luminosos y fachadas para empresas
        </h1>

        <p
          class="mt-5 max-w-2xl text-lg leading-relaxed text-(--color-foreground-muted)"
        >
          Diseñamos, fabricamos e instalamos rótulos luminosos y soluciones para
          fachadas comerciales y corporativas, adaptadas a la identidad de cada
          marca y a las características de cada espacio.
        </p>

        <div class="mt-7 flex flex-wrap gap-4">
          <ButtonLink href={paths.quote}> Solicitar presupuesto </ButtonLink>

          <ButtonLink href="#soluciones-rotulos" variant="secondary">
            Ver soluciones
          </ButtonLink>
        </div>
      </div>

      <div class="aspect-4/3 overflow-hidden rounded-2xl">
        <img
          src="/ImagenesWebClav/Fotos%20Nuevas/rotulo-iluminado-mimma-gallery-noche.jpeg"
          alt="Rótulo de MIMMA Gallery iluminado en una fachada por la noche"
          class="h-full w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </Container>
</section>
