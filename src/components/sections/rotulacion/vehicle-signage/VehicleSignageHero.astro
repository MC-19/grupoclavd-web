---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Container from "@/components/ui/Container.astro";
import { paths } from "@/data/navigation";
---

<section class="py-12 lg:py-16">
  <Container>
    <div
      class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16"
    >
      <div>
        <p
          class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
        >
          Rotulación de vehículos
        </p>

        <h1
          class="text-4xl font-black leading-tight text-(--color-foreground) sm:text-5xl lg:text-6xl"
        >
          Rotulación de vehículos para empresas
        </h1>

        <p
          class="mt-5 max-w-2xl text-lg leading-relaxed text-(--color-foreground-muted)"
        >
          Diseñamos y aplicamos soluciones de rotulación para vehículos
          comerciales y flotas, adaptadas a la identidad visual de cada empresa
          y a las características de cada vehículo.
        </p>

        <div class="mt-7 flex flex-wrap gap-4">
          <ButtonLink href={paths.quote}>Solicitar presupuesto</ButtonLink>

          <ButtonLink href="#soluciones-vehiculos" variant="secondary">
            Ver soluciones
          </ButtonLink>
        </div>
      </div>

      <div
        class="flex aspect-4/3 items-center justify-center overflow-hidden rounded-2xl bg-(--color-surface-muted) px-6 text-center text-sm font-semibold text-(--color-foreground-muted)"
        role="img"
        aria-label="Espacio reservado para una imagen de un vehículo comercial rotulado"
      >
        Imagen de vehículo comercial rotulado
      </div>
    </div>
  </Container>
</section>
