---
import Container from "@/components/ui/Container.astro";

const solutions = [
  {
    number: "01",
    title: "Rotulación integral",
    description:
      "Aplicación gráfica planteada para cubrir gran parte del vehículo y conseguir una imagen visual unificada.",
  },
  {
    number: "02",
    title: "Rotulación parcial",
    description:
      "Aplicación de la identidad visual en zonas seleccionadas del vehículo para adaptar la intervención a las necesidades de cada proyecto.",
  },
  {
    number: "03",
    title: "Logotipos y datos comerciales",
    description:
      "Incorporación de logotipos, información de empresa y elementos gráficos para identificar el vehículo de forma clara.",
  },
];
---

<section
  id="soluciones-vehiculos"
  class="bg-(--color-surface-muted) py-16 lg:py-20"
>
  <Container>
    <div class="max-w-3xl">
      <p
        class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
      >
        Opciones de rotulación
      </p>

      <h2
        class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl"
      >
        Soluciones de rotulación para vehículos
      </h2>

      <p
        class="mt-5 max-w-2xl text-lg leading-relaxed text-(--color-foreground-muted)"
      >
        El alcance de la gráfica puede adaptarse a la presencia que necesita la
        marca y a la información que debe comunicar cada vehículo.
      </p>
    </div>

    <div class="mt-12 border-t border-(--color-border)">
      {
        solutions.map((solution) => (
          <article class="grid gap-5 border-b border-(--color-border) py-8 md:grid-cols-[80px_0.8fr_1.2fr] md:items-start md:gap-8 lg:py-10">
            <span class="text-sm font-black tracking-[0.15em] text-(--color-accent-500)">
              {solution.number}
            </span>

            <h3 class="text-2xl font-black text-(--color-foreground)">
              {solution.title}
            </h3>

            <p class="max-w-2xl leading-relaxed text-(--color-foreground-muted)">
              {solution.description}
            </p>
          </article>
        ))
      }
    </div>
  </Container>
</section>
