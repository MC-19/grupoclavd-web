---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Container from "@/components/ui/Container.astro";
import { paths } from "@/data/navigation";
---

<section class="py-16 lg:py-20">
  <Container>
    <div
      class="relative overflow-hidden rounded-3xl bg-(--color-foreground) px-6 py-10 text-center sm:px-10 lg:px-16 lg:py-14"
    >
      <div
        class="pointer-events-none absolute -bottom-24 -left-20 size-64 rounded-full bg-(--color-primary-500)/20 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="relative">
        <p
          class="text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
        >
          Cuéntanos tu proyecto
        </p>

        <h2
          class="mx-auto mt-3 max-w-3xl text-3xl font-black leading-tight text-white sm:text-4xl lg:text-5xl"
        >
          ¿Quieres rotular un vehículo o una flota?
        </h2>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white/70">
          Envíanos el modelo, fotografías y el número de vehículos, junto con el
          logotipo y las zonas que quieres rotular. Con esa información podemos
          valorar el diseño y la aplicación de la gráfica.
        </p>

        <div class="mt-8 flex justify-center">
          <ButtonLink href={paths.quote}>Solicitar presupuesto</ButtonLink>
        </div>
      </div>
    </div>
  </Container>
</section>
