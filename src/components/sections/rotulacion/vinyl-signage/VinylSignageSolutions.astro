---
import Container from "@/components/ui/Container.astro";

const solutions = [
  {
    title: "Vinilos de corte",
    image: "/ImagenesWebClav/Fotos%20Nuevas/grafica-heineken-pared-interior.jpeg",
    imageAlt: "Gráfica de marca aplicada a una pared interior",
    description:
      "Gráfica recortada para aplicar logotipos, textos y formas que ayuden a identificar o comunicar dentro de un espacio.",
  },
  {
    title: "Vinilos impresos",
    image: "/ImagenesWebClav/Fotos%20Que%20si/grafica-mural-corte-ingles-interior.jpg",
    imageAlt: "Gráfica mural impresa en un espacio interior",
    description:
      "Gráfica impresa para reproducir diseños, imágenes y composiciones visuales adaptadas a cada campaña o proyecto.",
  },
];
---

<section
  id="soluciones-vinilos"
  class="bg-(--color-surface-muted) py-16 lg:py-20"
>
  <Container>
    <div class="max-w-3xl">
      <p
        class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)"
      >
        Soluciones gráficas
      </p>

      <h2
        class="text-3xl font-black leading-tight text-(--color-foreground) sm:text-4xl lg:text-5xl"
      >
        Soluciones de vinilo para espacios comerciales y corporativos
      </h2>

      <p
        class="mt-5 max-w-2xl text-lg leading-relaxed text-(--color-foreground-muted)"
      >
        La solución se plantea según el contenido gráfico, la superficie donde
        se aplicará y la función visual que debe cumplir en el espacio.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        solutions.map((solution) => (
          <article class="overflow-hidden rounded-2xl border border-(--color-border) bg-white">
            <div class="aspect-16/9 overflow-hidden">
              <img src={solution.image} alt={solution.imageAlt} class="h-full w-full object-cover" loading="lazy" decoding="async" />
            </div>

            <div class="p-6 sm:p-7">
              <h3 class="text-2xl font-bold text-(--color-foreground)">
                {solution.title}
              </h3>

              <p class="mt-3 max-w-xl leading-relaxed text-(--color-foreground-muted)">
                {solution.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>
