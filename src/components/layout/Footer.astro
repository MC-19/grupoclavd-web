---
import Container from "../ui/Container.astro";
import { footerNavigation, paths } from "../../data/navigation";

const { company, services, solutions } = footerNavigation;
---

<footer class="bg-(--color-foreground) text-white">
  <Container>
    <div
      class="grid gap-12 py-14 sm:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr_1fr] lg:py-16"
    >
      <!-- Marca -->
      <div class="max-w-sm">
        <a
          href={paths.home}
          aria-label="Ir al inicio de GrupoClavD"
          class="inline-flex"
        >
          <img
            src="/images/grupoclavd-logo-footer.png"
            alt=""
            width="600"
            height="182"
            class="h-auto w-48"
            loading="lazy"
          />
        </a>

        <p class="mt-6 leading-relaxed text-white/60">
          Rotulación, impresión digital e instalación para empresas en toda
          España.
        </p>

        <nav aria-label="Redes sociales" class="mt-5 flex flex-wrap gap-5">
          <a
            href="https://www.instagram.com/grupoclavd/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-white/70 transition hover:text-white"
            aria-label="Instagram de GrupoClavD (abre en una nueva pestaña)"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
            Instagram
          </a>
          <a
            href="https://www.facebook.com/GrupoClavD/?locale=es_ES"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-white/70 transition hover:text-white"
            aria-label="Facebook de GrupoClavD (abre en una nueva pestaña)"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.095 10.125 24v-8.437H7.078v-3.49h3.047v-2.66c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.971h-1.513c-1.49 0-1.956.931-1.956 1.887v2.263h3.328l-.532 3.49h-2.796V24C19.612 23.095 24 18.1 24 12.073Z" />
            </svg>
            Facebook
          </a>
        </nav>

        <a
          href={paths.quote}
          class="mt-6 inline-flex items-center rounded-xl bg-(--color-accent-500) px-5 py-3 font-semibold text-white transition hover:opacity-90"
        >
          Solicitar presupuesto
        </a>
      </div>

      <!-- Servicios -->
      <div>
        <h2 class="text-sm font-bold uppercase tracking-[0.15em] text-white/50">
          Servicios
        </h2>

        <ul class="mt-5 space-y-3">
          {
            services.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-white/70 transition hover:text-white"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Soluciones -->
      <div>
        <h2 class="text-sm font-bold uppercase tracking-[0.15em] text-white/50">
          Soluciones
        </h2>

        <ul class="mt-5 space-y-3">
          {
            solutions.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-white/70 transition hover:text-white"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Empresa -->
      <div>
        <h2 class="text-sm font-bold uppercase tracking-[0.15em] text-white/50">
          GrupoClavD
        </h2>

        <ul class="mt-5 space-y-3">
          {
            company.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-white/70 transition hover:text-white"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="flex flex-col gap-4 border-t border-white/10 py-6 text-sm text-white/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {new Date().getFullYear()} GrupoClavD. Todos los derechos reservados.
      </p>

      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a href={paths.legal} class="transition hover:text-white">
          Aviso legal
        </a>

        <a href={paths.privacy} class="transition hover:text-white">
          Privacidad
        </a>

        <a href={paths.cookies} class="transition hover:text-white">Cookies</a>

        <button id="manage-analytics-consent" type="button" class="transition hover:text-white">
          Preferencias de analítica
        </button>
      </div>
    </div>
  </Container>
</footer>


<script>
  document.querySelector("#manage-analytics-consent")?.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("gc:manage-consent"));
  });
</script>
