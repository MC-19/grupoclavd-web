---
import Container from "../ui/Container.astro";
import {
  isCurrentPath,
  mainNavigation,
  paths,
} from "../../data/navigation";

const pathname = Astro.url.pathname;
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-white/95 shadow-sm backdrop-blur-xl"
>
  <div class="h-1 bg-(--gradient-brand)" aria-hidden="true"></div>

  <Container>
    <div class="flex h-24 items-center justify-between">
      <a
        href={paths.home}
        aria-label="Ir al inicio de GrupoClavD"
        class="inline-flex shrink-0 flex-col"
      >
        <span
          class="logo-text text-4xl font-black leading-none tracking-[0.12em]"
        >
          CLAVD
        </span>

        <span
          class="mt-1 text-[0.55rem] font-semibold tracking-[0.42em] text-(--color-foreground-muted)"
        >
          ROTULACIÓN Y MONTAJES
        </span>
      </a>

      <nav class="hidden min-[900px]:block" aria-label="Navegación principal">
        <ul class="flex items-center gap-1">
          {
            mainNavigation.map((item) => {
              const isActive = isCurrentPath(pathname, item.href);

              const isBudget = item.href === paths.quote;
              const hasChildren = item.children?.length;

              return (
                <li class="group relative">
                  <a
                    href={item.href}
                    aria-current={isActive ? "page" : undefined}
                    class:list={[
                      "inline-flex items-center gap-1 px-4 py-2 text-lg transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--color-accent-500)",

                      isBudget
                        ? "ml-2 rounded-lg border border-(--color-accent-500) font-semibold text-(--color-accent-500) hover:scale-105 hover:bg-(--color-accent-500) hover:text-white"
                        : "hover:scale-105 hover:font-bold hover:text-(--color-accent-500)",

                      !isBudget &&
                        (isActive
                          ? "scale-105 font-bold text-(--color-accent-500)"
                          : "font-semibold"),
                    ]}
                  >
                    {item.name}

                    {hasChildren && (
                      <span
                        class="text-sm transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180"
                        aria-hidden="true"
                      >
                        ↓
                      </span>
                    )}
                  </a>

                  {hasChildren && (
                    <div class="pointer-events-none invisible absolute left-1/2 top-full z-50 w-72 -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition duration-200 group-hover:pointer-events-auto group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                      <div class="overflow-hidden rounded-2xl border border-(--color-border) bg-white p-2 shadow-xl">
                        <a
                          href={paths.services}
                          class="block rounded-xl px-4 py-3 font-bold text-(--color-foreground) transition hover:bg-(--color-surface-muted) hover:text-(--color-accent-500)"
                        >
                          Ver todos los servicios
                        </a>

                        <div class="my-1 border-t border-(--color-border)" />

                        {item.children?.map((child) => (
                          <a
                            href={child.href}
                            class="block rounded-xl px-4 py-2.5 font-medium text-(--color-foreground-muted) transition hover:bg-(--color-surface-muted) hover:text-(--color-accent-500)"
                          >
                            {child.name}
                          </a>
                        ))}
                      </div>
                    </div>
                  )}
                </li>
              );
            })
          }
        </ul>
      </nav>

      <button
        id="menu-button"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex flex-col gap-1.5 rounded-md p-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--color-accent-500) min-[900px]:hidden"
      >
        <span
          id="line-1"
          class="h-0.5 w-7 bg-(--color-foreground) transition-all duration-300"
        ></span>

        <span
          id="line-2"
          class="h-0.5 w-7 bg-(--color-foreground) transition-all duration-0"
        ></span>

        <span
          id="line-3"
          class="h-0.5 w-7 bg-(--color-foreground) transition-all duration-300"
        ></span>
      </button>

      <nav
        id="mobile-menu"
        aria-label="Navegación móvil"
        aria-hidden="true"
        inert
        class="pointer-events-none absolute left-0 top-full w-full -translate-y-2 bg-white opacity-0 shadow-md transition-all duration-300 min-[900px]:hidden"
      >
        <ul class="flex flex-col p-4">
          {
            mainNavigation.map((item) => {
              const isActive = isCurrentPath(pathname, item.href);

              const isBudget = item.href === paths.quote;
              const hasChildren = item.children?.length;

              return (
                <li>
                  {hasChildren ? (
                    <>
                      <div class="flex items-center">
                        <a
                          href={item.href}
                          aria-current={isActive ? "page" : undefined}
                          class:list={[
                            "flex-1 px-4 py-3 font-semibold transition-colors",
                            isActive && "text-(--color-accent-500)",
                          ]}
                        >
                          {item.name}
                        </a>

                        <button
                          type="button"
                          class="mobile-submenu-button flex h-12 w-12 items-center justify-center"
                          aria-label={`Mostrar ${item.name}`}
                          aria-expanded="false"
                        >
                          <span class="transition-transform duration-200">
                            ↓
                          </span>
                        </button>
                      </div>

                      <div class="mobile-submenu hidden pl-4">
                        <a
                          href={paths.services}
                          class="block rounded-lg px-4 py-2.5 font-semibold text-(--color-foreground)"
                        >
                          Ver todos los servicios
                        </a>

                        {item.children?.map((child) => (
                          <a
                            href={child.href}
                            class="block rounded-lg px-4 py-2.5 text-sm font-medium text-(--color-foreground-muted) transition-colors hover:text-(--color-accent-500)"
                          >
                            {child.name}
                          </a>
                        ))}
                      </div>
                    </>
                  ) : (
                    <a
                      href={item.href}
                      aria-current={isActive ? "page" : undefined}
                      class:list={[
                        "block px-4 py-3 font-semibold transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--color-accent-500)",

                        isBudget
                          ? "mt-2 rounded-lg border border-(--color-accent-500) text-center text-(--color-accent-500) hover:bg-(--color-accent-500) hover:text-white"
                          : "hover:text-(--color-accent-500)",

                        !isBudget && isActive && "text-(--color-accent-500)",
                      ]}
                    >
                      {item.name}
                    </a>
                  )}
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>
  </Container>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>("#menu-button");
  const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");

  const line1 = document.querySelector<HTMLElement>("#line-1");
  const line2 = document.querySelector<HTMLElement>("#line-2");
  const line3 = document.querySelector<HTMLElement>("#line-3");

  function setMenuOpen(isOpen: boolean, returnFocus = false) {
    if (!menuButton || !mobileMenu) return;

    mobileMenu.classList.toggle("opacity-0", !isOpen);
    mobileMenu.classList.toggle("-translate-y-2", !isOpen);
    mobileMenu.classList.toggle("pointer-events-none", !isOpen);
    mobileMenu.toggleAttribute("inert", !isOpen);
    mobileMenu.setAttribute("aria-hidden", String(!isOpen));

    menuButton.setAttribute("aria-expanded", String(isOpen));
    menuButton.setAttribute(
      "aria-label",
      isOpen ? "Cerrar menú" : "Abrir menú",
    );

    line1?.classList.toggle("translate-y-2", isOpen);
    line1?.classList.toggle("rotate-45", isOpen);
    line2?.classList.toggle("opacity-0", isOpen);
    line3?.classList.toggle("-translate-y-2", isOpen);
    line3?.classList.toggle("-rotate-45", isOpen);

    document.body.classList.toggle("overflow-hidden", isOpen);

    if (returnFocus) menuButton.focus();
  }

  menuButton?.addEventListener("click", () => {
    const isOpen = menuButton.getAttribute("aria-expanded") !== "true";
    setMenuOpen(isOpen);

    if (isOpen) {
      mobileMenu?.querySelector<HTMLElement>("a, button")?.focus();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuButton?.getAttribute("aria-expanded") === "true") {
      setMenuOpen(false, true);
    }
  });

  document.addEventListener("click", (event) => {
    if (
      menuButton?.getAttribute("aria-expanded") === "true" &&
      event.target instanceof Node &&
      !mobileMenu?.contains(event.target) &&
      !menuButton.contains(event.target)
    ) {
      setMenuOpen(false);
    }
  });

  const desktopMedia = window.matchMedia("(min-width: 900px)");
  desktopMedia.addEventListener("change", (event) => {
    if (event.matches) setMenuOpen(false);
  });

  const submenuButtons = document.querySelectorAll(".mobile-submenu-button");

  submenuButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const parent = button.parentElement?.parentElement;
      const submenu = parent?.querySelector<HTMLElement>(".mobile-submenu");
      const arrow = button.querySelector<HTMLElement>("span");

      submenu?.classList.toggle("hidden");

      const isOpen = !submenu?.classList.contains("hidden");

      button.setAttribute("aria-expanded", String(isOpen));
      button.setAttribute(
        "aria-label",
        `${isOpen ? "Ocultar" : "Mostrar"} ${button.getAttribute("aria-label")?.replace(/^(Mostrar|Ocultar) /, "") ?? "submenú"}`,
      );
      arrow?.classList.toggle("rotate-180", isOpen);
    });
  });
</script>
