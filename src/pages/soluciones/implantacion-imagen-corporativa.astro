---
import SolutionLanding from "@/components/sections/solutions/SolutionLanding.astro";
import { paths } from "@/data/navigation";
import BaseLayout from "@/layouts/BaseLayout.astro";

const needs = [
  "Trasladar la identidad visual a elementos físicos reconocibles.",
  "Relacionar cada pieza con el espacio y su función.",
  "Coordinar el conjunto para mantener una lectura coherente de la marca.",
];

const elements = [
  { title: "Fachadas y rótulos", text: "Elementos de identificación exterior adaptados a la presencia visual del establecimiento.", href: paths.illuminatedSigns },
  { title: "Vinilos y gráfica", text: "Aplicaciones visuales para cristales, paredes, escaparates e interiores.", href: paths.vinyls },
  { title: "Señalética", text: "Piezas que identifican, orientan y organizan la información dentro del espacio.", href: paths.wayfinding },
];

const process = [
  { title: "Identidad y espacio", text: "Partimos de los recursos de marca disponibles y de fotografías, medidas o planos del lugar." },
  { title: "Definición del conjunto", text: "Ordenamos los elementos necesarios según su función, ubicación y relación visual." },
  { title: "Producción e instalación", text: "Preparamos y colocamos las piezas incluidas en el proyecto de acuerdo con el alcance confirmado." },
];
---

<BaseLayout title="Implantación de imagen corporativa | GrupoClavD" description="Producción e instalación de elementos de imagen corporativa para espacios comerciales, establecimientos y empresas.">
  <SolutionLanding
    eyebrow="Imagen corporativa"
    heading="Llevamos tu identidad al espacio físico"
    intro="Producimos e instalamos los elementos visuales que trasladan una identidad corporativa a fachadas, interiores, establecimientos y espacios comerciales."
    image="/images/work/implantacion-grafica-tag-heuer.jpg"
    imageAlt="Gráfica corporativa de TAG Heuer integrada en un espacio comercial"
    imageCaption="Integración de gráfica de marca en un espacio comercial."
    overviewEyebrow="Del diseño al espacio"
    overviewHeading="Una identidad aplicada como un conjunto"
    overviewText="Implantar una imagen no consiste en sumar piezas aisladas. Importa cómo conviven los rótulos, la gráfica y la señalización, cómo se leen y qué función cumple cada elemento en su ubicación."
    {needs}
    elementsHeading="Elementos que pueden formar parte de la implantación"
    {elements}
    processHeading="De los recursos de marca al resultado instalado"
    processIntro="Definimos cada actuación a partir del espacio real y de los elementos que el proyecto necesita."
    {process}
    ctaHeading="¿Quieres implantar tu imagen en un espacio?"
    ctaText="Envíanos los recursos de marca, fotografías del lugar y una descripción de los elementos previstos para preparar una propuesta."
  />
</BaseLayout>
