---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Container from "@/components/ui/Container.astro";
import { paths } from "@/data/navigation";
import BaseLayout from "@/layouts/BaseLayout.astro";

const elements = [
  { title: "Rótulos y fachadas", href: paths.illuminatedSigns }, { title: "Letras corpóreas", href: paths.dimensionalLetters }, { title: "Vinilos y gráfica", href: paths.vinyls }, { title: "Señalética", href: paths.wayfinding }, { title: "Impresión digital", href: paths.digitalPrinting }, { title: "Instalación", href: paths.installation },
];
---

<BaseLayout title="Implantación de imagen corporativa | GrupoClavD" description="Producción e instalación de elementos de imagen corporativa para espacios comerciales, establecimientos y empresas.">
  <section class="py-12 lg:py-16"><Container><div class="max-w-4xl"><p class="text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">Imagen corporativa</p><h1 class="mt-3 text-4xl font-black leading-tight text-(--color-foreground) sm:text-5xl lg:text-6xl">Llevamos tu identidad al espacio físico</h1><p class="mt-5 max-w-3xl text-lg leading-relaxed text-(--color-foreground-muted)">Producimos e instalamos los elementos visuales que trasladan una identidad corporativa a fachadas, interiores, establecimientos y espacios comerciales.</p><div class="mt-7"><ButtonLink href={paths.quote}>Solicitar presupuesto</ButtonLink></div></div></Container></section>
  <section class="bg-(--color-surface-muted) py-16 lg:py-20" aria-labelledby="diseno-espacio"><Container class="grid gap-12 lg:grid-cols-2"><div><p class="text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">Del diseño al espacio</p><h2 id="diseno-espacio" class="mt-3 text-3xl font-black text-(--color-foreground) sm:text-4xl">Una identidad aplicada con coherencia</h2></div><div><p class="text-lg leading-relaxed text-(--color-foreground-muted)">La implantación parte de una identidad ya definida y la convierte en elementos físicos adaptados al lugar. No consiste solo en producir piezas aisladas: importa cómo conviven, se leen y funcionan dentro del espacio.</p><p class="mt-4 leading-relaxed text-(--color-foreground-muted)">Dimensiones, composición y ubicación se valoran según las necesidades de cada proyecto y el entorno donde se incorporarán.</p></div></Container></section>
  <section class="py-16 lg:py-20" aria-labelledby="elementos"><Container><h2 id="elementos" class="text-3xl font-black text-(--color-foreground) sm:text-4xl">Elementos de una implantación</h2><div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{elements.map((element) => <a href={element.href} class="group flex min-h-28 items-center justify-between rounded-2xl border border-(--color-border-strong) p-6 font-black text-(--color-foreground) transition hover:border-(--color-accent-500) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent-500)">{element.title}<span class="text-(--color-accent-500) transition-transform group-hover:translate-x-1" aria-hidden="true">→</span></a>)}</div></Container></section>
  <section class="bg-(--color-foreground) py-16 text-white lg:py-20" aria-labelledby="ejecucion"><Container class="grid gap-10 lg:grid-cols-2"><div><p class="text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-400)">Coordinación y ejecución</p><h2 id="ejecucion" class="mt-3 text-3xl font-black sm:text-4xl">Del conjunto de piezas al resultado final</h2></div><p class="text-lg leading-relaxed text-white/70">Coordinamos producción, logística e instalación para que rótulos, vinilos, señalética y gráfica respondan a una misma identidad en su ubicación final.</p></Container></section>
  <section class="py-16 lg:py-20"><Container><div class="flex flex-col gap-6 rounded-2xl bg-(--color-surface-muted) p-8 sm:flex-row sm:items-center sm:justify-between"><div><h2 class="text-2xl font-black text-(--color-foreground)">Implanta tu imagen en el espacio</h2><p class="mt-3 text-(--color-foreground-muted)">Cuéntanos qué elementos forman parte de tu proyecto.</p></div><ButtonLink href={paths.contact} class="shrink-0">Contactar</ButtonLink></div></Container></section>
</BaseLayout>
