---
import SolutionLanding from "@/components/sections/solutions/SolutionLanding.astro";
import { paths } from "@/data/navigation";
import BaseLayout from "@/layouts/BaseLayout.astro";

const needs = [
  "Mantener criterios visuales comunes entre establecimientos.",
  "Adaptar los elementos a las condiciones reales de cada ubicación.",
  "Coordinar producción, logística e instalación dentro del alcance acordado.",
];

const elements = [
  { title: "Rotulación", text: "Rótulos, fachadas y letras corpóreas vinculados a la identidad del establecimiento.", href: paths.signage },
  { title: "Gráfica impresa", text: "Vinilos, cartelería y piezas visuales para campañas o implantaciones comerciales.", href: paths.digitalPrinting },
  { title: "Instalación coordinada", text: "Organización de la colocación de los elementos incluidos en cada actuación.", href: paths.installation },
];

const process = [
  { title: "Alcance y referencias", text: "Revisamos las ubicaciones, los elementos necesarios y los recursos de identidad disponibles." },
  { title: "Producción coordinada", text: "Preparamos las piezas manteniendo criterios comunes y atendiendo a las particularidades de cada espacio." },
  { title: "Logística e instalación", text: "Organizamos entregas y colocaciones según el alcance y la planificación acordados para el proyecto." },
];
---

<BaseLayout title="Rotulación para franquicias y cadenas | GrupoClavD" description="Soluciones de rotulación, impresión e instalación para empresas con múltiples establecimientos y redes comerciales.">
  <SolutionLanding
    eyebrow="Franquicias y cadenas"
    heading="Imagen coordinada en múltiples ubicaciones"
    intro="Coordinamos soluciones de rotulación, impresión digital e instalación para empresas que necesitan mantener una imagen reconocible en distintos establecimientos."
    image="/images/work/fachada-comercial-pikolinos.jpg"
    imageAlt="Fachada de un establecimiento Pikolinos con su identidad visual aplicada"
    imageCaption="Ejemplo de identidad visual aplicada a un establecimiento comercial."
    overviewEyebrow="Entornos multiubicación"
    overviewHeading="Coherencia de marca sin perder de vista cada espacio"
    overviewText="Cada local tiene dimensiones, recorridos y elementos existentes diferentes. La coordinación parte de una identidad común, pero debe considerar la realidad de cada ubicación antes de producir e instalar."
    {needs}
    elementsHeading="Qué podemos coordinar en una implantación"
    {elements}
    processHeading="Un proyecto común, organizado por ubicaciones"
    processIntro="La secuencia se adapta al alcance real del encargo y a la información disponible de cada establecimiento."
    {process}
    ctaHeading="¿Necesitas coordinar varias ubicaciones?"
    ctaText="Cuéntanos cuántos espacios forman parte del proyecto, qué elementos necesitas y qué documentación de marca tienes disponible."
  />
</BaseLayout>
