---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Container from "@/components/ui/Container.astro";
import { paths } from "@/data/navigation";
import BaseLayout from "@/layouts/BaseLayout.astro";

const needs = ["Mantener una imagen reconocible entre establecimientos", "Coordinar piezas y actuaciones en distintas ubicaciones", "Adaptar la comunicación visual al espacio disponible"];
const coordination = [
  { title: "Producción", text: "Preparamos rótulos, gráfica y elementos visuales de acuerdo con la identidad del proyecto." },
  { title: "Logística", text: "Organizamos los elementos necesarios para las actuaciones previstas en cada ubicación." },
  { title: "Instalación", text: "Coordinamos el montaje para mantener una ejecución coherente entre establecimientos." },
];
const services = [
  { label: "Rotulación", href: paths.signage }, { label: "Impresión digital", href: paths.digitalPrinting }, { label: "Señalética", href: paths.wayfinding }, { label: "Instalación y montaje", href: paths.installation },
];
---

<BaseLayout title="Rotulación para franquicias y cadenas | GrupoClavD" description="Soluciones de rotulación, impresión e instalación para empresas con múltiples establecimientos y redes comerciales.">
  <section class="py-12 lg:py-16"><Container><div class="max-w-4xl"><p class="text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">Franquicias y cadenas</p><h1 class="mt-3 text-4xl font-black leading-tight text-(--color-foreground) sm:text-5xl lg:text-6xl">Imagen coordinada en múltiples ubicaciones</h1><p class="mt-5 max-w-3xl text-lg leading-relaxed text-(--color-foreground-muted)">Coordinamos soluciones de rotulación, impresión digital e instalación para empresas que necesitan mantener una imagen coherente en distintos establecimientos.</p><div class="mt-7"><ButtonLink href={paths.quote}>Solicitar presupuesto</ButtonLink></div></div></Container></section>
  <section class="bg-(--color-surface-muted) py-16 lg:py-20" aria-labelledby="necesidades"><Container><div class="grid gap-12 lg:grid-cols-2"><div><p class="text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">Entornos multiubicación</p><h2 id="necesidades" class="mt-3 text-3xl font-black text-(--color-foreground) sm:text-4xl">Una misma identidad en espacios diferentes</h2><p class="mt-5 text-lg leading-relaxed text-(--color-foreground-muted)">Cada local tiene su propio contexto, pero la marca debe seguir siendo reconocible. El proyecto debe contemplar el conjunto y también las condiciones de cada ubicación.</p></div><ul class="divide-y divide-(--color-border-strong) border-y border-(--color-border-strong)">{needs.map((need) => <li class="flex gap-4 py-5 text-lg font-semibold text-(--color-foreground)"><span class="text-(--color-accent-500)" aria-hidden="true">→</span>{need}</li>)}</ul></div></Container></section>
  <section class="py-16 lg:py-20" aria-labelledby="coordinacion"><Container><h2 id="coordinacion" class="text-3xl font-black text-(--color-foreground) sm:text-4xl">Qué podemos coordinar</h2><div class="mt-10 grid gap-6 md:grid-cols-3">{coordination.map((item) => <article class="rounded-2xl border border-(--color-border-strong) p-7"><h3 class="text-xl font-black text-(--color-foreground)">{item.title}</h3><p class="mt-4 leading-relaxed text-(--color-foreground-muted)">{item.text}</p></article>)}</div></Container></section>
  <section class="bg-(--color-foreground) py-16 text-white lg:py-20" aria-labelledby="servicios-relacionados"><Container><h2 id="servicios-relacionados" class="text-3xl font-black sm:text-4xl">Servicios relacionados</h2><div class="mt-8 flex flex-wrap gap-3">{services.map((service) => <a href={service.href} class="inline-flex min-h-11 items-center rounded-xl border border-white/25 px-5 py-3 font-semibold transition hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">{service.label} <span class="ml-2" aria-hidden="true">→</span></a>)}</div></Container></section>
  <section class="py-16 lg:py-20"><Container><div class="flex flex-col gap-6 rounded-2xl bg-(--color-surface-muted) p-8 sm:flex-row sm:items-center sm:justify-between"><div><h2 class="text-2xl font-black text-(--color-foreground)">¿Tienes varias ubicaciones?</h2><p class="mt-3 text-(--color-foreground-muted)">Cuéntanos el alcance del proyecto y las necesidades de tu red.</p></div><ButtonLink href={paths.contact} class="shrink-0">Hablar con GrupoClavD</ButtonLink></div></Container></section>
</BaseLayout>
