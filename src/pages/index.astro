---
import CTA from "../components/sections/index/CTA.astro";
import FaqSection from "../components/sections/index/FaqSection.astro";
import Franquicias from "../components/sections/index/Franquicias.astro";
import Hero from "../components/sections/index/Hero.astro";
import Logistica from "../components/sections/index/Logistica.astro";
import Proyectos from "../components/sections/index/Proyectos.astro";
import Servicios from "../components/sections/index/Servicios.astro";
import Ubicacion from "../components/sections/index/Ubicacion.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { halloweenEnabled } from "../config/seasonal";
import HalloweenCampaign from "../components/seasonal/HalloweenCampaign.astro";
---

<BaseLayout
  title="Empresa de Rotulación e Impresión Digital en España | GrupoClavD"
  description="Rotulación, impresión digital e instalación para empresas desde Elche. Atendemos Alicante y coordinamos proyectos con cobertura nacional."
>
  <Hero />
  {halloweenEnabled && <HalloweenCampaign />}
  <Servicios />
  <Logistica />
  <Ubicacion />
  <Proyectos />
  <Franquicias />
  <FaqSection />
  <CTA />
</BaseLayout>
