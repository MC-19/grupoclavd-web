---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Container from "@/components/ui/Container.astro";
import { paths } from "@/data/navigation";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Presupuesto | GrupoClavD"
  description="Próximamente podrás obtener una estimación orientativa para proyectos de rotulación, impresión digital e instalación con GrupoClavD."
>
  <section class="py-12 lg:py-20">
    <Container>
      <div class="mx-auto max-w-5xl overflow-hidden rounded-2xl border border-(--color-border-strong) bg-white">
        <div class="grid lg:grid-cols-[minmax(0,3fr)_minmax(280px,2fr)]">
          <div class="p-7 sm:p-10 lg:p-14">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">Presupuesto</p>
            <p class="mt-6 inline-flex rounded-full bg-(--color-surface-muted) px-4 py-2 text-sm font-bold uppercase tracking-[0.14em] text-(--color-foreground)">Próximamente</p>
            <h1 class="mt-5 text-4xl font-black leading-tight text-(--color-foreground) sm:text-5xl lg:text-6xl">Tu presupuesto, más fácil</h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-(--color-foreground-muted)">Estamos preparando una herramienta para que puedas indicarnos qué necesitas y obtener una estimación orientativa para tu proyecto.</p>
            <p class="mt-4 max-w-2xl leading-relaxed text-(--color-foreground-muted)">Podrás configurar tu solicitud según el tipo de trabajo, las medidas, las cantidades y otras características del proyecto. La valoración final dependerá siempre de las condiciones reales de cada trabajo.</p>
          </div>

          <div class="relative min-h-72 overflow-hidden bg-(--color-foreground) p-7 text-white sm:p-10 lg:min-h-full" aria-hidden="true">
            <div class="absolute -right-16 -top-16 size-56 rounded-full border border-white/15"></div>
            <div class="absolute -bottom-20 -left-20 size-64 rounded-full border border-white/10"></div>
            <div class="relative flex h-full flex-col justify-center gap-4">
              <div class="h-3 w-2/3 rounded-full bg-white/20"></div>
              <div class="h-16 rounded-xl border border-white/15 bg-white/5"></div>
              <div class="grid grid-cols-2 gap-4">
                <div class="h-24 rounded-xl border border-white/15 bg-white/5"></div>
                <div class="h-24 rounded-xl border border-white/15 bg-white/5"></div>
              </div>
              <div class="h-11 w-1/2 self-end rounded-xl bg-(--color-accent-500)"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="mx-auto mt-8 flex max-w-5xl flex-col gap-6 rounded-2xl bg-(--color-surface-muted) p-7 sm:flex-row sm:items-center sm:justify-between sm:p-8">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-black text-(--color-foreground)">¿Necesitas solicitar presupuesto ahora?</h2>
          <p class="mt-3 leading-relaxed text-(--color-foreground-muted)">Puedes escribirnos desde Contacto y contarnos qué necesitas.</p>
        </div>
        <ButtonLink href={paths.contact} class="shrink-0">Contactar con GrupoClavD</ButtonLink>
      </div>
    </Container>
  </section>
</BaseLayout>
