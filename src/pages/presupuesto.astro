---
import QuoteCalculator from "@/components/quote/QuoteCalculator.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Container from "@/components/ui/Container.astro";
import { paths } from "@/data/navigation";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Calcula tu presupuesto orientativo | GrupoClavD"
  description="Calcula una estimación orientativa para vinilos, lonas y otros productos de GrupoClavD y solicita un presupuesto personalizado."
>
  <section class="py-12 lg:py-16">
    <Container>
      <div class="max-w-4xl">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">
          Presupuesto
        </p>
        <h1 class="mt-3 text-4xl font-black leading-tight text-(--color-foreground) sm:text-5xl lg:text-6xl">
          Calcula tu presupuesto orientativo
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-(--color-foreground-muted)">
          Añade los productos o servicios que necesitas y obtén una primera
          estimación cuando exista una tarifa fija. Los trabajos que dependen
          del material, el acabado o las condiciones del proyecto se marcarán
          para valoración personalizada.
        </p>
        <div class="mt-7 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
          <p class="font-semibold text-(--color-foreground)">
            ¿No sabes qué material necesitas? Cuéntanos tu proyecto.
          </p>
          <ButtonLink href={paths.contact} variant="secondary">
            Ir al formulario de contacto
          </ButtonLink>
        </div>
      </div>

      <div class="mt-10 lg:mt-12">
        <QuoteCalculator />
      </div>
    </Container>
  </section>
</BaseLayout>
