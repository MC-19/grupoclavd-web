---
import ArticleCard from "@/components/sections/blog/ArticleCard.astro";
import Container from "@/components/ui/Container.astro";
import { blogArticles } from "@/data/blog";
import BaseLayout from "@/layouts/BaseLayout.astro";

const featured = blogArticles.filter((article) => article.featured);
const moreArticles = blogArticles.filter((article) => !article.featured);
---

<BaseLayout
  title="Blog sobre rotulación e impresión digital | GrupoClavD"
  description="Guías prácticas sobre rotulación, impresión digital e instalación para empresas y espacios comerciales."
>
  <section class="py-12 lg:py-16">
    <Container>
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">Blog</p>
        <h1 class="mt-3 text-4xl font-black leading-tight text-(--color-foreground) sm:text-5xl lg:text-6xl">Ideas y consejos sobre rotulación e impresión</h1>
        <p class="mt-5 text-lg leading-relaxed text-(--color-foreground-muted)">Guías prácticas sobre rotulación, impresión digital e instalación para empresas y espacios comerciales.</p>
      </div>
    </Container>
  </section>

  <section class="bg-(--color-surface-muted) py-12 lg:py-16" aria-labelledby="articulos-destacados">
    <Container>
      <h2 id="articulos-destacados" class="text-2xl font-black text-(--color-foreground) sm:text-3xl">Artículos destacados</h2>
      <div class="mt-8 grid max-w-5xl gap-6 md:grid-cols-2">
        {featured.map((article) => <ArticleCard article={article} prominent />)}
      </div>
    </Container>
  </section>

  <section class="py-12 lg:py-16" aria-labelledby="mas-articulos">
    <Container>
      <h2 id="mas-articulos" class="text-2xl font-black text-(--color-foreground) sm:text-3xl">Más guías</h2>
      <div class="mt-8 grid max-w-5xl gap-6 md:grid-cols-2">
        {moreArticles.map((article) => <ArticleCard article={article} />)}
      </div>
    </Container>
  </section>
</BaseLayout>
