---
import Container from "@/components/ui/Container.astro";
import { blogArticles, type BlogArticle } from "@/data/blog";
import { paths } from "@/data/navigation";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return blogArticles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props {
  article: BlogArticle;
}

const { article } = Astro.props;
---

<BaseLayout title={article.seoTitle} description={article.description} image={article.image}>
  <article class="py-12 lg:py-16">
    <Container>
      <div class="mx-auto max-w-3xl">
        <a href={paths.blog} class="font-semibold text-(--color-foreground-muted) underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--color-accent-500)">← Volver al blog</a>
        <header class="mt-10">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-(--color-accent-500)">{article.category}</p>
          <h1 class="mt-3 text-4xl font-black leading-tight text-(--color-foreground) sm:text-5xl">{article.title}</h1>
          {article.publishedAt && <time datetime={article.publishedAt} class="mt-4 block text-sm text-(--color-foreground-muted)">{new Intl.DateTimeFormat("es-ES", { dateStyle: "long" }).format(new Date(article.publishedAt))}</time>}
          <p class="mt-7 text-xl leading-relaxed text-(--color-foreground-muted)">{article.introduction}</p>
        </header>

        {article.image && article.imageAlt && <img src={article.image} alt={article.imageAlt} class="mt-10 aspect-[16/9] w-full rounded-2xl object-cover" />}

        <div class="mt-12 space-y-12">
          {article.sections.map((section) => (
            <section>
              <h2 class="text-2xl font-black leading-tight text-(--color-foreground) sm:text-3xl">{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p class="mt-5 text-lg leading-relaxed text-(--color-foreground-muted)">{paragraph}</p>)}
              {section.points && <ul class="mt-5 list-disc space-y-2 pl-6 text-lg leading-relaxed text-(--color-foreground-muted)">{section.points.map((point) => <li>{point}</li>)}</ul>}
            </section>
          ))}
        </div>

        <aside class="mt-14 border-t border-(--color-border-strong) pt-8" aria-labelledby="servicios-relacionados">
          <h2 id="servicios-relacionados" class="text-xl font-black text-(--color-foreground)">Servicios relacionados</h2>
          <ul class="mt-4 flex flex-wrap gap-3">
            {article.relatedServices.map((service) => <li><a href={service.href} class="inline-flex min-h-11 items-center rounded-xl border border-(--color-border-strong) px-4 py-2 font-semibold text-(--color-foreground) transition hover:bg-(--color-surface-muted) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent-500)">{service.label} <span class="ml-2" aria-hidden="true">→</span></a></li>)}
          </ul>
          <p class="mt-8 text-(--color-foreground-muted)">¿Tienes un espacio o una idea concreta? <a href={paths.quote} class="font-semibold text-(--color-foreground) underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--color-accent-500)">Cuéntanos qué necesitas</a>.</p>
        </aside>
      </div>
    </Container>
  </article>
</BaseLayout>
