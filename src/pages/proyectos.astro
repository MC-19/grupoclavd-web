---
import ProjectCard from "@/components/sections/projects/ProjectCard.astro";
import Container from "@/components/ui/Container.astro";
import { allProjects, featuredProjects } from "@/data/projects";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Proyectos de rotulación e impresión digital | GrupoClavD"
  description="Una selección visual de proyectos de rotulación, gráfica e instalación de GrupoClavD en fachadas, interiores, espacios comerciales y vehículos."
  image={featuredProjects[0].cover}
>
  <section class="py-12 lg:py-16">
    <Container>
      <div class="max-w-3xl">
        <h1 class="text-4xl font-black leading-tight text-(--color-foreground) sm:text-5xl lg:text-6xl">Proyectos</h1>
        <p class="mt-5 text-lg leading-relaxed text-(--color-foreground-muted)">Una selección de trabajos de rotulación, impresión digital e instalación, mostrados a través de sus imágenes.</p>
      </div>
      <div id="project-filters" class="mt-8 hidden flex-wrap gap-3" role="group" aria-label="Filtrar proyectos">
        <button type="button" data-project-filter="todos" aria-pressed="true" class="min-h-11 rounded-xl border border-(--color-border-strong) bg-white px-5 py-2 font-semibold text-(--color-foreground) transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent-500) aria-pressed:border-(--color-foreground) aria-pressed:bg-(--color-foreground) aria-pressed:text-white">Todos</button>
        <button type="button" data-project-filter="rotulacion" aria-pressed="false" class="min-h-11 rounded-xl border border-(--color-border-strong) bg-white px-5 py-2 font-semibold text-(--color-foreground) transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent-500) aria-pressed:border-(--color-foreground) aria-pressed:bg-(--color-foreground) aria-pressed:text-white">Rotulación</button>
        <button type="button" data-project-filter="impresion-digital" aria-pressed="false" class="min-h-11 rounded-xl border border-(--color-border-strong) bg-white px-5 py-2 font-semibold text-(--color-foreground) transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent-500) aria-pressed:border-(--color-foreground) aria-pressed:bg-(--color-foreground) aria-pressed:text-white">Impresión digital</button>
        <button type="button" data-project-filter="instalacion-montaje" aria-pressed="false" class="min-h-11 rounded-xl border border-(--color-border-strong) bg-white px-5 py-2 font-semibold text-(--color-foreground) transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent-500) aria-pressed:border-(--color-foreground) aria-pressed:bg-(--color-foreground) aria-pressed:text-white">Instalación y montaje</button>
      </div>
      <p id="project-filter-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {allProjects.map((project) => (
          <div data-project-item data-project-filters={project.filters.join(" ")}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  const filterGroup = document.getElementById("project-filters");
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-project-filter]")];
  const items = [...document.querySelectorAll<HTMLElement>("[data-project-item]")];
  const status = document.getElementById("project-filter-status");

  filterGroup?.classList.replace("hidden", "flex");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const selected = button.dataset.projectFilter;
      let visible = 0;

      items.forEach((item) => {
        const matches = selected === "todos" || item.dataset.projectFilters?.split(" ").includes(selected ?? "") === true;
        item.hidden = !matches;
        if (matches) visible++;
      });

      buttons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
      if (status) status.textContent = `${visible} ${visible === 1 ? "proyecto" : "proyectos"} en ${button.textContent?.trim() ?? "el filtro"}`;
    });
  });
</script>
